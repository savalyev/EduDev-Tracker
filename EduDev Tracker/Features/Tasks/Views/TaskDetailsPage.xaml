<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EduDev_Tracker.Features.Tasks.Views.TaskDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:EduDev_Tracker.Features.Tasks.ViewModels"
    Title=""
    x:DataType="vm:TaskDetailsViewModel"
    BackgroundColor="#0A0E1A"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False">

    <ContentPage.Behaviors>
        <mct:EventToCommandBehavior Command="{Binding InitCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#0A0E1A" />
                <GradientStop Offset="0.5" Color="#0D1530" />
                <GradientStop Offset="1" Color="#0A1628" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <Grid
                Padding="16"
                HorizontalOptions="Center"
                MaximumWidthRequest="800"
                RowDefinitions="Auto, Auto"
                RowSpacing="16">

                <!--  ══ ШАПКА ══  -->
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="Auto, *, Auto, Auto"
                    ColumnSpacing="10">

                    <Border
                        Grid.Column="0"
                        BackgroundColor="#14182E"
                        HeightRequest="36"
                        Stroke="#495061"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        WidthRequest="36">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="←"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Style="{StaticResource EduCardTitleLabel}" Text="Детали задачи" />
                        <Label Style="{StaticResource EduCardSubtitleLabel}" Text="{Binding CreatedAtText}" />
                    </VerticalStackLayout>

                    <!--  Редактировать / Сохранить  -->
                    <Button
                        Grid.Column="2"
                        Command="{Binding ToggleEditCommand}"
                        Style="{StaticResource EduFilterButton}"
                        Text="{Binding EditButtonText}"
                        VerticalOptions="Center" />

                    <Button
                        Grid.Column="3"
                        Command="{Binding SaveCommand}"
                        IsVisible="{Binding IsEditing}"
                        Style="{StaticResource EduPrimaryButton}"
                        Text="Сохранить"
                        VerticalOptions="Center" />
                </Grid>

                <!--  ══ КОНТЕНТ ══  -->
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="{OnIdiom Phone='*',
                                                Default='*, 300'}"
                    ColumnSpacing="16"
                    RowDefinitions="{OnIdiom Phone='Auto,Auto',
                                             Default='Auto'}"
                    RowSpacing="16">

                    <!--  ── Левая колонка: основная информация ──  -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="20"
                        Style="{StaticResource EduCardBorder}">
                        <VerticalStackLayout Spacing="20">

                            <!--  Название  -->
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource EduCardSubtitleLabel}" Text="Название" />
                                <!--  VIEW режим  -->
                                <Label
                                    FontFamily="Comfortaa"
                                    FontSize="18"
                                    IsVisible="{Binding IsNotEditing}"
                                    Text="{Binding TaskTitle}"
                                    TextColor="White" />
                                <!--  EDIT режим  -->
                                <Border
                                    Padding="12,10"
                                    BackgroundColor="#14182E"
                                    IsVisible="{Binding IsEditing}"
                                    Stroke="#5B5FEF"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Entry
                                        FontFamily="Comfortaa"
                                        FontSize="14"
                                        MaxLength="300"
                                        Text="{Binding TaskTitle}"
                                        TextColor="White" />
                                </Border>
                            </VerticalStackLayout>

                            <!--  Описание  -->
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource EduCardSubtitleLabel}" Text="Описание" />
                                <Label
                                    FontFamily="Comfortaa"
                                    FontSize="14"
                                    IsVisible="{Binding IsNotEditing}"
                                    Text="{Binding Description}"
                                    TextColor="#CCFFFFFF" />
                                <Border
                                    Padding="12,10"
                                    BackgroundColor="#14182E"
                                    IsVisible="{Binding IsEditing}"
                                    Stroke="#5B5FEF"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Editor
                                        AutoSize="TextChanges"
                                        FontFamily="Comfortaa"
                                        FontSize="14"
                                        MinimumHeightRequest="80"
                                        Text="{Binding Description}"
                                        TextColor="White" />
                                </Border>
                            </VerticalStackLayout>

                            <!--  Дедлайн  -->
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource EduCardSubtitleLabel}" Text="Дедлайн" />
                                <Label
                                    FontFamily="Comfortaa"
                                    FontSize="14"
                                    IsVisible="{Binding IsNotEditing}"
                                    Text="{Binding DeadlineText}"
                                    TextColor="{Binding DeadlineTextColor}" />
                                <VerticalStackLayout IsVisible="{Binding IsEditing}" Spacing="10">
                                    <Border
                                        Grid.Column="0"
                                        Padding="12,10"
                                        BackgroundColor="#14182E"
                                        Stroke="#5B5FEF"
                                        StrokeThickness="1">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <DatePicker
                                            Date="{Binding DueDate}"
                                            FontFamily="Comfortaa"
                                            FontSize="14"
                                            Format="d MMM yyyy"
                                            HorizontalOptions="Center"
                                            TextColor="White" />
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Padding="12,10"
                                        BackgroundColor="#14182E"
                                        Stroke="#5B5FEF"
                                        StrokeThickness="1">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <TimePicker
                                            FontFamily="Comfortaa"
                                            FontSize="14"
                                            Format="HH:mm"
                                            HorizontalOptions="Center"
                                            TextColor="White"
                                            Time="{Binding DueTime}" />
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!--  Категория  -->
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource EduCardSubtitleLabel}" Text="Категория" />
                                <Label
                                    FontFamily="Comfortaa"
                                    FontSize="14"
                                    IsVisible="{Binding IsNotEditing}"
                                    Text="{Binding Category}"
                                    TextColor="#CCFFFFFF" />
                                <Border
                                    Padding="12,10"
                                    BackgroundColor="#14182E"
                                    IsVisible="{Binding IsEditing}"
                                    Stroke="#5B5FEF"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Entry
                                        FontFamily="Comfortaa"
                                        FontSize="14"
                                        Text="{Binding Category}"
                                        TextColor="White" />
                                </Border>
                            </VerticalStackLayout>

                            <!--  ══ ПОВТОРЯЕМОСТЬ ══  -->
                            <VerticalStackLayout IsVisible="{Binding HasRecurrence}" Spacing="6">
                                <Label
                                    FontFamily="Comfortaa"
                                    FontSize="14"
                                    Text="Повторяемость"
                                    TextColor="White" />
                                <Border
                                    Padding="12,10"
                                    BackgroundColor="#1A1A3E"
                                    Stroke="#5B5FEF"
                                    StrokeThickness="0.5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label
                                            FontFamily="Comfortaa"
                                            FontSize="13"
                                            Text="{Binding RecurrenceSummary}"
                                            TextColor="#AAAAFF" />
                                        <Label
                                            FontFamily="Comfortaa"
                                            FontSize="11"
                                            IsVisible="{Binding HasNextDueText}"
                                            Text="{Binding NextDueText}"
                                            TextColor="#99FFFFFF" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>


                        </VerticalStackLayout>
                    </Border>

                    <!--  ── Правая колонка: статус, приоритет, действия ──  -->
                    <VerticalStackLayout
                        Grid.Row="{OnIdiom Phone=1,
                                           Default=0}"
                        Grid.Column="{OnIdiom Phone=0,
                                              Default=1}"
                        Spacing="12">

                        <!--  Статус  -->
                        <Border Padding="16" Style="{StaticResource EduCardBorder}">
                            <VerticalStackLayout Spacing="10">
                                <Label Style="{StaticResource EduCardTitleLabel}" Text="Статус" />
                                <VerticalStackLayout Spacing="6">
                                    <Button
                                        Command="{Binding ChangeStatusCommand}"
                                        CommandParameter="Open"
                                        HorizontalOptions="Fill"
                                        Style="{StaticResource EduFilterButton}"
                                        Text="К выполнению">
                                        <Button.Triggers>
                                            <DataTrigger
                                                Binding="{Binding CurrentStatus}"
                                                TargetType="Button"
                                                Value="Open">
                                                <Setter Property="BackgroundColor" Value="#8E44AD" />
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="BorderColor" Value="#9B59B6" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button
                                        Command="{Binding ChangeStatusCommand}"
                                        CommandParameter="InProgress"
                                        HorizontalOptions="Fill"
                                        Style="{StaticResource EduFilterButton}"
                                        Text="В процессе">
                                        <Button.Triggers>
                                            <DataTrigger
                                                Binding="{Binding CurrentStatus}"
                                                TargetType="Button"
                                                Value="InProgress">
                                                <Setter Property="BackgroundColor" Value="#E67E22" />
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="BorderColor" Value="#F39C12" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button
                                        Command="{Binding ChangeStatusCommand}"
                                        CommandParameter="Done"
                                        HorizontalOptions="Fill"
                                        Style="{StaticResource EduFilterButton}"
                                        Text="Завершено">
                                        <Button.Triggers>
                                            <DataTrigger
                                                Binding="{Binding CurrentStatus}"
                                                TargetType="Button"
                                                Value="Done">
                                                <Setter Property="BackgroundColor" Value="#27AE60" />
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="BorderColor" Value="#2ECC71" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button
                                        Command="{Binding ChangeStatusCommand}"
                                        CommandParameter="Cancelled"
                                        HorizontalOptions="Fill"
                                        Style="{StaticResource EduFilterButton}"
                                        Text="Отменено">
                                        <Button.Triggers>
                                            <DataTrigger
                                                Binding="{Binding CurrentStatus}"
                                                TargetType="Button"
                                                Value="Cancelled">
                                                <Setter Property="BackgroundColor" Value="#555555" />
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="BorderColor" Value="#777777" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!--  Приоритет  -->
                        <Border Padding="16" Style="{StaticResource EduCardBorder}">
                            <VerticalStackLayout Spacing="10">
                                <Label Style="{StaticResource EduCardTitleLabel}" Text="Приоритет" />
                                <VerticalStackLayout Spacing="6">
                                    <Button
                                        Command="{Binding ChangePriorityCommand}"
                                        CommandParameter="Low"
                                        HorizontalOptions="Fill"
                                        Style="{StaticResource EduFilterButton}"
                                        Text="Низкий">
                                        <Button.Triggers>
                                            <DataTrigger
                                                Binding="{Binding CurrentPriority}"
                                                TargetType="Button"
                                                Value="Low">
                                                <Setter Property="BackgroundColor" Value="#27AE60" />
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="BorderColor" Value="#2ECC71" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button
                                        Command="{Binding ChangePriorityCommand}"
                                        CommandParameter="Medium"
                                        HorizontalOptions="Fill"
                                        Style="{StaticResource EduFilterButton}"
                                        Text="Средний">
                                        <Button.Triggers>
                                            <DataTrigger
                                                Binding="{Binding CurrentPriority}"
                                                TargetType="Button"
                                                Value="Medium">
                                                <Setter Property="BackgroundColor" Value="#2980B9" />
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="BorderColor" Value="#3498DB" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button
                                        Command="{Binding ChangePriorityCommand}"
                                        CommandParameter="High"
                                        HorizontalOptions="Fill"
                                        Style="{StaticResource EduFilterButton}"
                                        Text="Высокий">
                                        <Button.Triggers>
                                            <DataTrigger
                                                Binding="{Binding CurrentPriority}"
                                                TargetType="Button"
                                                Value="High">
                                                <Setter Property="BackgroundColor" Value="#E67E22" />
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="BorderColor" Value="#F39C12" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button
                                        Command="{Binding ChangePriorityCommand}"
                                        CommandParameter="Urgent"
                                        HorizontalOptions="Fill"
                                        Style="{StaticResource EduFilterButton}"
                                        Text="Критичный">
                                        <Button.Triggers>
                                            <DataTrigger
                                                Binding="{Binding CurrentPriority}"
                                                TargetType="Button"
                                                Value="Urgent">
                                                <Setter Property="BackgroundColor" Value="#C0392B" />
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="BorderColor" Value="#E74C3C" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!--  Действия  -->
                        <Border Padding="16" Style="{StaticResource EduCardBorder}">
                            <VerticalStackLayout Spacing="8">
                                <Label Style="{StaticResource EduCardTitleLabel}" Text="Действия" />
                                <Button
                                    Command="{Binding OpenReminderCommand}"
                                    HorizontalOptions="Fill"
                                    Style="{StaticResource EduFilterButton}"
                                    Text="Напоминание" />
                                <Button
                                    Command="{Binding ArchiveCommand}"
                                    HorizontalOptions="Fill"
                                    Style="{StaticResource EduFilterButton}"
                                    Text="{Binding ArchiveButtonText}" />
                                <Button
                                    BackgroundColor="#2A0A0A"
                                    BorderColor="#C0392B"
                                    Command="{Binding DeleteCommand}"
                                    FontFamily="Comfortaa"
                                    FontSize="13"
                                    HeightRequest="40"
                                    HorizontalOptions="Fill"
                                    Text="Удалить задачу"
                                    TextColor="#FF6B6B" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Grid>

            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
