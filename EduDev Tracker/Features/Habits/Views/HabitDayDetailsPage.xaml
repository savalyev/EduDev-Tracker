<?xml version="1.0" encoding="utf-8" ?>
<local:AnimatedModalPage
    x:Class="EduDev_Tracker.Features.Habits.Views.HabitDayDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:EduDev_Tracker.Core.Helpers"
    xmlns:vm="clr-namespace:EduDev_Tracker.Features.Habits.ViewModels"
    Title=""
    x:DataType="vm:HabitDayDetailsViewModel"
    BackgroundColor="#0A0E1A"
    Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#0A0E1A" />
                <GradientStop Offset="0.5" Color="#0D1530" />
                <GradientStop Offset="1" Color="#0A1628" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout
                HorizontalOptions="Center"
                MaximumWidthRequest="720"
                Padding="20"
                Spacing="16">

                <!--  Шапка  -->
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label
                            FontFamily="Comfortaa"
                            FontSize="20"
                            Text="Привычки за день"
                            TextColor="White" />
                        <Label
                            FontFamily="Comfortaa"
                            FontSize="14"
                            Text="{Binding DateHeader}"
                            TextColor="#99FFFFFF" />
                    </VerticalStackLayout>
                    <Button
                        Grid.Column="1"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource EduPrimaryButton}"
                        Text="✕ Закрыть"
                        VerticalOptions="Center" />
                </Grid>

                <!--  Пустое состояние  -->
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsEmpty}"
                    Spacing="12"
                    VerticalOptions="Center">
                    <Label
                        FontFamily="Comfortaa"
                        FontSize="36"
                        HorizontalOptions="Center"
                        Text="😴"
                        TextColor="White" />
                    <Label
                        FontFamily="Comfortaa"
                        FontSize="16"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="На этот день привычек не было запланировано"
                        TextColor="#99FFFFFF" />
                </VerticalStackLayout>

                <!--  Выполненные привычки  -->
                <VerticalStackLayout IsVisible="{Binding HasCompleted}" Spacing="8">
                    <HorizontalStackLayout Spacing="8">
                        <BoxView
                            BackgroundColor="#6EE7B7"
                            CornerRadius="3"
                            HeightRequest="20"
                            VerticalOptions="Center"
                            WidthRequest="4" />
                        <Label
                            FontAttributes="Bold"
                            FontFamily="Comfortaa"
                            FontSize="15"
                            Text="Выполнено"
                            TextColor="#6EE7B7"
                            VerticalOptions="Center" />
                        <Label
                            FontFamily="Comfortaa"
                            FontSize="13"
                            Text="{Binding CompletedHabits.Count, StringFormat='({0})'}"
                            TextColor="#99FFFFFF"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <BindableLayout.ItemsSource>
                            <Binding Path="CompletedHabits" />
                        </BindableLayout.ItemsSource>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:HabitDayItem">
                                <Border
                                    Margin="0,0,0,4"
                                    Padding="14"
                                    Background="#0D2A1A"
                                    Stroke="#996EE7B7"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="52, *" ColumnSpacing="12">
                                        <Border
                                            Padding="10"
                                            Background="#1D3A3A"
                                            HeightRequest="52"
                                            Stroke="#996EE7B7"
                                            WidthRequest="52">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Image Aspect="AspectFit" Source="{Binding Icon}" />
                                        </Border>
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="4"
                                            VerticalOptions="Center">
                                            <Label
                                                FontFamily="Comfortaa"
                                                FontSize="15"
                                                Text="{Binding Title}"
                                                TextColor="White" />
                                            <Label
                                                FontFamily="Comfortaa"
                                                FontSize="12"
                                                Text="✓ Выполнено"
                                                TextColor="#6EE7B7" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!--  Пропущенные привычки  -->
                <VerticalStackLayout IsVisible="{Binding HasMissed}" Spacing="8">
                    <HorizontalStackLayout Spacing="8">
                        <BoxView
                            BackgroundColor="#F87171"
                            CornerRadius="3"
                            HeightRequest="20"
                            VerticalOptions="Center"
                            WidthRequest="4" />
                        <Label
                            FontAttributes="Bold"
                            FontFamily="Comfortaa"
                            FontSize="15"
                            Text="Пропущено"
                            TextColor="#F87171"
                            VerticalOptions="Center" />
                        <Label
                            FontFamily="Comfortaa"
                            FontSize="13"
                            Text="{Binding MissedHabits.Count, StringFormat='({0})'}"
                            TextColor="#99FFFFFF"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <BindableLayout.ItemsSource>
                            <Binding Path="MissedHabits" />
                        </BindableLayout.ItemsSource>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:HabitDayItem">
                                <Border
                                    Margin="0,0,0,4"
                                    Padding="14"
                                    Background="#2A0D0D"
                                    Stroke="#99F87171"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="52, *" ColumnSpacing="12">
                                        <Border
                                            Padding="10"
                                            Background="#3A1D1D"
                                            HeightRequest="52"
                                            Stroke="#99F87171"
                                            WidthRequest="52">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Image Aspect="AspectFit" Source="{Binding Icon}" />
                                        </Border>
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="4"
                                            VerticalOptions="Center">
                                            <Label
                                                FontFamily="Comfortaa"
                                                FontSize="15"
                                                Text="{Binding Title}"
                                                TextColor="White" />
                                            <Label
                                                FontFamily="Comfortaa"
                                                FontSize="12"
                                                Text="✗ Пропущено"
                                                TextColor="#F87171" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</local:AnimatedModalPage>
