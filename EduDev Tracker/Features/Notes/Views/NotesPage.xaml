<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EduDev_Tracker.Features.Notes.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:EduDev_Tracker.Data.Models"
    xmlns:vm="clr-namespace:EduDev_Tracker.Features.Notes.ViewModels"
    Title="Заметки"
    x:DataType="vm:NotesViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!--  Цвета  -->
            <Color x:Key="BgPrimary">#0F1117</Color>
            <Color x:Key="BgSecondary">#161B27</Color>
            <Color x:Key="BgCard">#1C2333</Color>
            <Color x:Key="BgCardHover">#232B3E</Color>
            <Color x:Key="AccentBlue">#4F8EF7</Color>
            <Color x:Key="AccentBlueMuted">#2A4A8A</Color>
            <Color x:Key="AccentGreen">#019301</Color>
            <Color x:Key="TextPrimary">#E8EAF0</Color>
            <Color x:Key="TextSecondary">#94A3B8</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="BorderColor">#252D40</Color>
            <Color x:Key="PinnedAccent">#F59E0B</Color>
            <Color x:Key="DangerColor">#EF4444</Color>
            <Color x:Key="ToolbarBg">#1A2035</Color>

            <!--  Стили текста  -->
            <Style x:Key="HeadingStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="Comfortaa" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="SubheadingStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="Comfortaa" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            </Style>

            <Style x:Key="BodyStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <Style x:Key="MutedStyle" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
            </Style>

            <!--  Toolbar button  -->
            <Style x:Key="ToolbarBtnStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource BgCard}" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#1C2333" />
                                    <Setter Property="TextColor" Value="#8892A4" />
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#2A3550" />
                                    <Setter Property="TextColor" Value="#E8EAF0" />
                                    <Setter Property="Scale" Value="0.95" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#232B3E" />
                                    <Setter Property="Scale" Value="1.02" />
                                    <Setter Property="Opacity" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.4" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!--  Accent button  -->
            <Style x:Key="AccentBtnStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentBlue}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="Shadow">
                    <Shadow
                        Brush="#4F8EF7"
                        Opacity="0.3"
                        Radius="12"
                        Offset="0,4" />
                </Setter>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#4F8EF7" />
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#2A4A8A" />
                                    <Setter Property="Scale" Value="0.96" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.5" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#232B3E" />
                                    <Setter Property="Scale" Value="1.02" />
                                    <Setter Property="Opacity" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!--  Category chip  -->
            <Style x:Key="CategoryChipStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#1C2333" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Stroke" Value="#2A3550" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!--  Note card  -->
            <Style x:Key="NoteCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource BgCard}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!--  Section card  -->
            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource BgCard}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <!--  Search entry  -->
            <Style x:Key="SearchEntryStyle" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{StaticResource BgCard}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#1C2333" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Focused">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#232B3E" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!--  Editor  -->
            <Style x:Key="NoteEditorStyle" TargetType="Editor">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="Placeholder" Value="Начните писать в Markdown..." />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
            </Style>

            <!--  Markdown button  -->
            <Style x:Key="MdBtnStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="MinimumWidthRequest" Value="36" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                    <Setter Property="TextColor" Value="#8892A4" />
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#1C2333" />
                                    <Setter Property="TextColor" Value="#4F8EF7" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#1C2333" />
                                    <Setter Property="TextColor" Value="#4F8EF7" />
                                    <Setter Property="Scale" Value="0.9" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="RootGrid" BackgroundColor="{StaticResource BgPrimary}">

        <!--  Desktop  -->
        <Grid
            x:Name="DesktopLayout"
            ColumnDefinitions="300,*,280"
            ColumnSpacing="0"
            IsVisible="{Binding IsDesktopLayout}">

            <!--  Left column  -->
            <Grid
                Grid.Column="0"
                BackgroundColor="{StaticResource BgSecondary}"
                RowDefinitions="Auto,Auto,Auto,*">

                <Grid
                    Grid.Row="0"
                    Padding="16,16,16,12"
                    ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label
                            FontSize="18"
                            Style="{StaticResource HeadingStyle}"
                            Text="Заметки" />
                        <Label Style="{StaticResource MutedStyle}" Text="{Binding NotesCountText}" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Command="{Binding CreateNoteCommand}"
                        Style="{StaticResource AccentBtnStyle}"
                        Text="+ Новая"
                        VerticalOptions="Center" />
                </Grid>

                <Border
                    Grid.Row="1"
                    Margin="12,0,12,10"
                    Padding="10,4"
                    BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeShape="RoundRectangle 8">
                    <Entry
                        HeightRequest="44"
                        Placeholder="Поиск по заметкам..."
                        ReturnCommand="{Binding SearchCommand}"
                        Style="{StaticResource SearchEntryStyle}"
                        Text="{Binding SearchQuery}" />
                </Border>

                <VerticalStackLayout
                    Grid.Row="2"
                    Margin="12,0,12,10"
                    Spacing="0">

                    <ScrollView HeightRequest="60" Orientation="Horizontal">
                        <StackLayout
                            Padding="0,0,10,0"
                            Orientation="Horizontal"
                            Spacing="6">

                            <Border Style="{StaticResource CategoryChipStyle}">
                                <Label
                                    FontSize="12"
                                    Text="Все"
                                    TextColor="{StaticResource TextPrimary}" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" CommandParameter="{x:Null}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Style="{StaticResource CategoryChipStyle}">
                                <Label
                                    FontSize="12"
                                    Text="Закреплённые"
                                    TextColor="{StaticResource TextPrimary}" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowPinnedCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <StackLayout
                                BindableLayout.ItemsSource="{Binding Categories}"
                                Orientation="Horizontal"
                                Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:NoteCategory">
                                        <Border Style="{StaticResource CategoryChipStyle}">
                                            <Label
                                                FontSize="12"
                                                Text="{Binding Name}"
                                                TextColor="{StaticResource TextPrimary}" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotesViewModel}}, Path=SelectCategoryCommand}" CommandParameter="{Binding .}" />
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotesViewModel}}, Path=DeleteCategoryCommand}"
                                                    CommandParameter="{Binding .}"
                                                    NumberOfTapsRequired="2" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>

                            <Border
                                BackgroundColor="#1A2A4A"
                                Stroke="#2A4A8A"
                                Style="{StaticResource CategoryChipStyle}">
                                <Label
                                    FontSize="12"
                                    Text="＋ Категория"
                                    TextColor="#4F8EF7" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowAddCategoryCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </StackLayout>
                    </ScrollView>

                    <Border
                        Margin="0,6,0,0"
                        Padding="10,8"
                        BackgroundColor="#1C2333"
                        IsVisible="{Binding IsAddingCategory}"
                        Stroke="#2A3550"
                        StrokeShape="RoundRectangle 8">
                        <HorizontalStackLayout Spacing="6">
                            <Entry
                                FontSize="13"
                                HorizontalOptions="FillAndExpand"
                                Placeholder="Название категории"
                                PlaceholderColor="#4A5568"
                                ReturnCommand="{Binding CreateCategoryCommand}"
                                Text="{Binding NewCategoryName}"
                                TextColor="#E8EAF0" />
                            <Button
                                BackgroundColor="#2A4A8A"
                                Command="{Binding CreateCategoryCommand}"
                                CornerRadius="6"
                                HeightRequest="40"
                                Text="✓"
                                TextColor="#4F8EF7"
                                WidthRequest="36" />
                            <Button
                                BackgroundColor="Transparent"
                                Command="{Binding CancelAddCategoryCommand}"
                                FontSize="16"
                                HeightRequest="40"
                                Text="✕"
                                TextColor="#8892A4"
                                WidthRequest="32" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <CollectionView
                    Grid.Row="3"
                    Margin="8,0,8,0"
                    ItemsSource="{Binding FilteredNotes}"
                    SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                    SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Note">
                            <Border Margin="4,0,4,8" Style="{StaticResource NoteCardStyle}">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                        <Label
                                            Grid.Column="0"
                                            Margin="0,0,4,0"
                                            FontSize="11"
                                            IsVisible="{Binding IsPinned}"
                                            Text="●"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Title}"
                                            TextColor="{StaticResource TextPrimary}" />
                                        <Label
                                            Grid.Column="2"
                                            Style="{StaticResource MutedStyle}"
                                            Text="{Binding UpdatedAt, StringFormat='{0:dd MMM}'}"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <Label
                                        Grid.Row="1"
                                        FontSize="13"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding Content}"
                                        TextColor="{StaticResource TextSecondary}" />
                                    <Label
                                        Grid.Row="2"
                                        FontSize="11"
                                        IsVisible="{Binding CategoryId, Converter={StaticResource NullToBoolConverter}}"
                                        Text="{Binding CategoryName}"
                                        TextColor="{StaticResource AccentBlue}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            Padding="20"
                            HorizontalOptions="Center"
                            Spacing="8"
                            VerticalOptions="Center">
                            <Label
                                FontSize="14"
                                HorizontalOptions="Center"
                                Text="—"
                                TextColor="{StaticResource EduMutedText}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="Нет заметок"
                                TextColor="{StaticResource TextSecondary}" />
                            <Label
                                HorizontalOptions="Center"
                                Style="{StaticResource MutedStyle}"
                                Text="Создайте первую заметку" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.Footer>
                        <VerticalStackLayout
                            Padding="8,4,8,8"
                            IsVisible="{Binding NotesHasMore}"
                            Spacing="4">
                            <Label
                                FontFamily="Comfortaa"
                                FontSize="12"
                                HorizontalOptions="Center"
                                Text="{Binding NotesPageInfo}"
                                TextColor="#64748B" />
                            <Button
                                BackgroundColor="#111827"
                                BorderColor="#4F8EF7"
                                BorderWidth="1"
                                Command="{Binding LoadMoreNotesCommand}"
                                CornerRadius="10"
                                FontFamily="Comfortaa"
                                FontSize="14"
                                HeightRequest="36"
                                Text="Загрузить ещё →"
                                TextColor="#4F8EF7" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </Grid>

            <BoxView
                Grid.Column="0"
                BackgroundColor="{StaticResource BorderColor}"
                HorizontalOptions="End"
                VerticalOptions="Fill"
                WidthRequest="1" />

            <!--  Center column  -->
            <Grid
                Grid.Column="1"
                BackgroundColor="{StaticResource BgPrimary}"
                IsVisible="{Binding HasSelectedNote}"
                RowDefinitions="Auto,Auto,Auto,*,Auto">

                <Grid
                    Grid.Row="0"
                    Padding="20,16,20,0"
                    ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                    ColumnSpacing="8">
                    <Entry
                        Grid.Column="0"
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontSize="22"
                        Placeholder="Заголовок заметки..."
                        PlaceholderColor="{StaticResource TextMuted}"
                        Text="{Binding EditTitle}"
                        TextColor="{StaticResource TextPrimary}" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding TogglePinCommand}"
                        Style="{StaticResource ToolbarBtnStyle}"
                        Text="Закрепить"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="2"
                        Command="{Binding ShowVersionsCommand}"
                        Style="{StaticResource ToolbarBtnStyle}"
                        Text="Версии"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="3"
                        Command="{Binding SaveNoteCommand}"
                        Style="{StaticResource AccentBtnStyle}"
                        Text="Сохранить"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="4"
                        BackgroundColor="#2A1A1A"
                        Command="{Binding DeleteNoteCommand}"
                        CornerRadius="8"
                        FontSize="13"
                        HeightRequest="44"
                        Text="🗑"
                        TextColor="#EF4444"
                        WidthRequest="40" />
                </Grid>

                <StackLayout
                    Grid.Row="1"
                    Padding="20,6,20,0"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Label Style="{StaticResource MutedStyle}" Text="{Binding SelectedNote.UpdatedAt, StringFormat='обновлено {0:dd MMMM, HH:mm}'}" />
                    <Label Style="{StaticResource MutedStyle}" Text="•" />
                    <Label Style="{StaticResource MutedStyle}" Text="{Binding AutosaveStatus}" />
                </StackLayout>

                <Border
                    Grid.Row="2"
                    Margin="16,8,16,0"
                    Padding="8,4"
                    BackgroundColor="{StaticResource ToolbarBg}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeShape="RoundRectangle 8">
                    <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                        <StackLayout Orientation="Horizontal" Spacing="2">
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="bold"
                                Style="{StaticResource MdBtnStyle}"
                                Text="B" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="italic"
                                FontAttributes="Italic"
                                Style="{StaticResource MdBtnStyle}"
                                Text="I" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="h1"
                                Style="{StaticResource MdBtnStyle}"
                                Text="H1" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="h2"
                                Style="{StaticResource MdBtnStyle}"
                                Text="H2" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="h3"
                                Style="{StaticResource MdBtnStyle}"
                                Text="H3" />

                            <BoxView
                                Margin="4,0"
                                BackgroundColor="{StaticResource BorderColor}"
                                HeightRequest="20"
                                VerticalOptions="Center"
                                WidthRequest="1" />

                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="ulist"
                                Style="{StaticResource MdBtnStyle}"
                                Text="• List" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="olist"
                                Style="{StaticResource MdBtnStyle}"
                                Text="1. List" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="todo"
                                Style="{StaticResource MdBtnStyle}"
                                Text="[ ]" />

                            <BoxView
                                Margin="4,0"
                                BackgroundColor="{StaticResource BorderColor}"
                                HeightRequest="20"
                                VerticalOptions="Center"
                                WidthRequest="1" />

                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="link"
                                Style="{StaticResource MdBtnStyle}"
                                Text="Link" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="code"
                                Style="{StaticResource MdBtnStyle}"
                                Text="``` Code" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="divider"
                                Style="{StaticResource MdBtnStyle}"
                                Text="— Divider" />

                            <BoxView
                                Margin="4,0"
                                BackgroundColor="{StaticResource BorderColor}"
                                HeightRequest="20"
                                VerticalOptions="Center"
                                WidthRequest="1" />

                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="tag"
                                Style="{StaticResource MdBtnStyle}"
                                Text="#tag" />
                            <Button
                                Command="{Binding AddAttachmentCommand}"
                                FontSize="16"
                                Style="{StaticResource MdBtnStyle}"
                                Text="Прикрепить" />
                            <Button
                                Command="{Binding TogglePreviewCommand}"
                                Style="{StaticResource ToolbarBtnStyle}"
                                Text="{Binding IsPreviewMode, Converter={StaticResource BoolToPreviewLabelConverter}}" />
                        </StackLayout>
                    </ScrollView>
                </Border>

                <ScrollView
                    Grid.Row="3"
                    Padding="20,10,20,0"
                    IsVisible="{Binding IsPreviewMode, Converter={StaticResource InverseBoolConverter}}">
                    <Editor
                        x:Name="NoteEditor"
                        AutoSize="TextChanges"
                        CursorPosition="{Binding CursorPosition, Mode=TwoWay}"
                        MinimumHeightRequest="400"
                        SelectionLength="{Binding SelectionLength, Mode=TwoWay}"
                        Style="{StaticResource NoteEditorStyle}"
                        Text="{Binding EditContent}" />
                </ScrollView>

                <WebView
                    Grid.Row="3"
                    Margin="16,10"
                    IsVisible="{Binding IsPreviewMode}">
                    <WebView.Source>
                        <HtmlWebViewSource Html="{Binding MarkdownHtml}" />
                    </WebView.Source>
                </WebView>

                <Border
                    Grid.Row="4"
                    Padding="20,6"
                    BackgroundColor="{StaticResource BgSecondary}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource MutedStyle}"
                            Text="{Binding WordCountText}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Style="{StaticResource MutedStyle}"
                            Text="Markdown"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <VerticalStackLayout
                Grid.Column="1"
                HorizontalOptions="Center"
                IsVisible="{Binding HasSelectedNote, Converter={StaticResource InverseBoolConverter}}"
                Spacing="12"
                VerticalOptions="Center">
                <Label
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="—"
                    TextColor="{StaticResource EduMutedText}" />
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="Выберите заметку"
                    TextColor="{StaticResource TextSecondary}" />
                <Label
                    HorizontalOptions="Center"
                    Style="{StaticResource MutedStyle}"
                    Text="или создайте новую" />
            </VerticalStackLayout>

            <BoxView
                Grid.Column="1"
                BackgroundColor="{StaticResource BorderColor}"
                HorizontalOptions="End"
                VerticalOptions="Fill"
                WidthRequest="1" />

            <!--  Right column  -->
            <ScrollView
                Grid.Column="2"
                Padding="16"
                BackgroundColor="{StaticResource BgSecondary}"
                IsVisible="{Binding HasSelectedNote}">
                <VerticalStackLayout Spacing="0">

                    <Border Style="{StaticResource SectionCardStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="Свойства заметки"
                                TextColor="{StaticResource TextPrimary}" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    FontSize="14"
                                    Style="{StaticResource MutedStyle}"
                                    Text="Категория"
                                    VerticalOptions="Center" />
                                <Picker
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    FontSize="14"
                                    HorizontalOptions="End"
                                    ItemDisplayBinding="{Binding Name}"
                                    ItemsSource="{Binding Categories}"
                                    SelectedItem="{Binding SelectedNoteCategory}"
                                    TextColor="{StaticResource TextPrimary}"
                                    WidthRequest="130" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Text="Вложения"
                                    TextColor="{StaticResource TextPrimary}" />
                                <Button
                                    Grid.Column="1"
                                    Padding="10,6"
                                    Command="{Binding AddAttachmentCommand}"
                                    FontSize="13"
                                    HeightRequest="36"
                                    Style="{StaticResource ToolbarBtnStyle}"
                                    Text="+ Файл" />
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedNoteAttachments}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:NoteAttachment">
                                        <Border
                                            Padding="10,8"
                                            BackgroundColor="{StaticResource BgSecondary}"
                                            Stroke="{StaticResource BorderColor}"
                                            StrokeShape="RoundRectangle 6">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                                <Label
                                                    Grid.Column="0"
                                                    FontSize="18"
                                                    Text="{Binding MimeType, Converter={StaticResource MimeToIconConverter}}"
                                                    VerticalOptions="Center" />

                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label
                                                        FontSize="14"
                                                        LineBreakMode="TailTruncation"
                                                        Text="{Binding FileName}"
                                                        TextColor="{StaticResource TextPrimary}" />
                                                    <Label
                                                        FontSize="13"
                                                        Style="{StaticResource MutedStyle}"
                                                        Text="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}" />
                                                </VerticalStackLayout>

                                                <Button
                                                    Grid.Column="2"
                                                    Padding="10,6"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotesViewModel}}, Path=OpenAttachmentCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="13"
                                                    HeightRequest="36"
                                                    Style="{StaticResource ToolbarBtnStyle}"
                                                    Text="Открыть" />

                                                <Button
                                                    Grid.Column="3"
                                                    Padding="4"
                                                    BackgroundColor="Transparent"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotesViewModel}}, Path=DeleteAttachmentCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="14"
                                                    Text="Удалить"
                                                    TextColor="#E05555" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label
                                Padding="0,8"
                                HorizontalOptions="Center"
                                IsVisible="{Binding HasNoAttachments}"
                                Style="{StaticResource MutedStyle}"
                                Text="Нет вложений" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="История версий"
                                TextColor="{StaticResource TextPrimary}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding NoteVersions}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:NoteVersion">
                                        <Grid
                                            Padding="0,4"
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="8">
                                            <Border
                                                Grid.Column="0"
                                                Padding="8,4"
                                                BackgroundColor="{StaticResource AccentBlueMuted}"
                                                StrokeShape="RoundRectangle 4">
                                                <Label
                                                    FontSize="13"
                                                    Text="{Binding VersionLabel}"
                                                    TextColor="{StaticResource AccentBlue}" />
                                            </Border>

                                            <Label
                                                Grid.Column="1"
                                                FontSize="13"
                                                Style="{StaticResource MutedStyle}"
                                                Text="{Binding SavedAt, StringFormat='{0:dd MMM, HH:mm}'}"
                                                VerticalOptions="Center" />

                                            <Button
                                                Grid.Column="2"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotesViewModel}}, Path=RestoreVersionCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource MdBtnStyle}"
                                                Text="↺" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label
                                Padding="0,4"
                                FontSize="13"
                                HorizontalOptions="Center"
                                IsVisible="{Binding HasNoVersions}"
                                Style="{StaticResource MutedStyle}"
                                Text="Нет сохранённых версий" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="Экспорт"
                                TextColor="{StaticResource TextPrimary}" />
                            <StackLayout Orientation="Horizontal" Spacing="8">
                                <Button
                                    Command="{Binding ExportCommand}"
                                    CommandParameter="docx"
                                    HorizontalOptions="FillAndExpand"
                                    Style="{StaticResource ToolbarBtnStyle}"
                                    Text=".docx" />
                                <Button
                                    Command="{Binding ExportCommand}"
                                    CommandParameter="md"
                                    HorizontalOptions="FillAndExpand"
                                    Style="{StaticResource ToolbarBtnStyle}"
                                    Text=".md" />
                                <Button
                                    Command="{Binding ExportCommand}"
                                    CommandParameter="txt"
                                    HorizontalOptions="FillAndExpand"
                                    Style="{StaticResource ToolbarBtnStyle}"
                                    Text=".txt" />
                            </StackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!--  Mobile  -->
        <Grid
            x:Name="MobileLayout"
            IsVisible="{Binding IsMobileLayout}"
            RowDefinitions="Auto,*">

            <!--  Header  -->
            <Grid
                Grid.Row="0"
                Padding="12,10"
                BackgroundColor="{StaticResource BgSecondary}"
                ColumnDefinitions="Auto,*,Auto">
                <Button
                    Grid.Column="0"
                    Command="{Binding MobileBackCommand}"
                    IsVisible="{Binding MobileShowEditor}"
                    Style="{StaticResource MdBtnStyle}"
                    Text="←" />

                <Image
                    HeightRequest="36"
                    HorizontalOptions="Start"
                    IsVisible="{Binding MobileShowEditor, Converter={StaticResource InverseBoolConverter}}"
                    Source="menu.png"
                    VerticalOptions="Center"
                    WidthRequest="36">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped" />
                    </Image.GestureRecognizers>
                </Image>

                <Label
                    Grid.Column="1"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Style="{StaticResource HeadingStyle}"
                    Text="{Binding MobileHeaderTitle}"
                    VerticalOptions="Center" />

                <Button
                    Grid.Column="2"
                    Padding="10,6"
                    Command="{Binding CreateNoteCommand}"
                    IsVisible="{Binding MobileShowEditor, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource AccentBtnStyle}"
                    Text="+ Новая" />

                <Button
                    Grid.Column="2"
                    Padding="10,6"
                    Command="{Binding SaveNoteCommand}"
                    IsVisible="{Binding MobileShowEditor}"
                    Style="{StaticResource AccentBtnStyle}"
                    Text="Сохранить" />
            </Grid>

            <!--  Mobile list  -->
            <Grid
                Grid.Row="1"
                IsVisible="{Binding MobileShowEditor, Converter={StaticResource InverseBoolConverter}}"
                RowDefinitions="Auto,Auto,Auto,*">

                <Border
                    Grid.Row="0"
                    Margin="12,8"
                    Padding="10,4"
                    BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeShape="RoundRectangle 8">
                    <Entry
                        HeightRequest="44"
                        Placeholder="Поиск..."
                        ReturnCommand="{Binding SearchCommand}"
                        Style="{StaticResource SearchEntryStyle}"
                        Text="{Binding SearchQuery}" />
                </Border>

                <ScrollView
                    Grid.Row="1"
                    Margin="12,0,12,8"
                    Orientation="Horizontal">
                    <StackLayout Orientation="Horizontal" Spacing="6">

                        <Border Style="{StaticResource CategoryChipStyle}">
                            <Label
                                FontSize="12"
                                Text="Все"
                                TextColor="{StaticResource TextPrimary}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" CommandParameter="{x:Null}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Style="{StaticResource CategoryChipStyle}">
                            <Label
                                FontSize="12"
                                Text="Закреплённые"
                                TextColor="{StaticResource TextPrimary}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowPinnedCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <StackLayout
                            BindableLayout.ItemsSource="{Binding Categories}"
                            Orientation="Horizontal"
                            Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:NoteCategory">
                                    <Border Style="{StaticResource CategoryChipStyle}">
                                        <Label
                                            FontSize="12"
                                            Text="{Binding Name}"
                                            TextColor="{StaticResource TextPrimary}" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotesViewModel}}, Path=SelectCategoryCommand}" CommandParameter="{Binding .}" />
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotesViewModel}}, Path=DeleteCategoryCommand}"
                                                CommandParameter="{Binding .}"
                                                NumberOfTapsRequired="2" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>

                        <Border
                            BackgroundColor="#1A2A4A"
                            Stroke="#2A4A8A"
                            Style="{StaticResource CategoryChipStyle}">
                            <Label
                                FontSize="12"
                                Text="＋ Категория"
                                TextColor="#4F8EF7" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowAddCategoryCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </StackLayout>
                </ScrollView>

                <Border
                    Grid.Row="2"
                    Margin="12,0,12,8"
                    Padding="10,8"
                    BackgroundColor="#1C2333"
                    IsVisible="{Binding IsAddingCategory}"
                    Stroke="#2A3550"
                    StrokeShape="RoundRectangle 8">
                    <HorizontalStackLayout Spacing="6">
                        <Entry
                            FontSize="13"
                            HorizontalOptions="FillAndExpand"
                            Placeholder="Название категории"
                            PlaceholderColor="#4A5568"
                            ReturnCommand="{Binding CreateCategoryCommand}"
                            Text="{Binding NewCategoryName}"
                            TextColor="#E8EAF0" />
                        <Button
                            BackgroundColor="#2A4A8A"
                            Command="{Binding CreateCategoryCommand}"
                            CornerRadius="6"
                            HeightRequest="32"
                            Text="✓"
                            TextColor="#4F8EF7"
                            WidthRequest="36" />
                        <Button
                            BackgroundColor="Transparent"
                            Command="{Binding CancelAddCategoryCommand}"
                            FontSize="16"
                            HeightRequest="32"
                            Text="✕"
                            TextColor="#8892A4"
                            WidthRequest="32" />
                    </HorizontalStackLayout>
                </Border>

                <CollectionView
                    Grid.Row="3"
                    ItemsSource="{Binding FilteredNotes}"
                    SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                    SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Note">
                            <Border Margin="12,0,12,8" Style="{StaticResource NoteCardStyle}">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                        <Label
                                            Grid.Column="0"
                                            Margin="0,0,4,0"
                                            FontSize="11"
                                            IsVisible="{Binding IsPinned}"
                                            Text="●"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Title}"
                                            TextColor="{StaticResource TextPrimary}" />
                                        <Label
                                            Grid.Column="2"
                                            Style="{StaticResource MutedStyle}"
                                            Text="{Binding UpdatedAt, StringFormat='{0:dd MMM}'}" />
                                    </Grid>

                                    <Label
                                        Grid.Row="1"
                                        FontSize="13"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding Content}"
                                        TextColor="{StaticResource TextSecondary}" />

                                    <Label
                                        Grid.Row="2"
                                        FontSize="11"
                                        IsVisible="{Binding CategoryId, Converter={StaticResource NullToBoolConverter}}"
                                        Text="{Binding CategoryName}"
                                        TextColor="{StaticResource AccentBlue}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <VerticalStackLayout
                            Padding="12,4,12,12"
                            IsVisible="{Binding NotesHasMore}"
                            Spacing="4">
                            <Label
                                FontFamily="Comfortaa"
                                FontSize="12"
                                HorizontalOptions="Center"
                                Text="{Binding NotesPageInfo}"
                                TextColor="#64748B" />
                            <Button
                                BackgroundColor="#111827"
                                BorderColor="#4F8EF7"
                                BorderWidth="1"
                                Command="{Binding LoadMoreNotesCommand}"
                                CornerRadius="10"
                                FontFamily="Comfortaa"
                                FontSize="15"
                                HeightRequest="44"
                                Text="Загрузить ещё →"
                                TextColor="#4F8EF7" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </Grid>

            <!--  Mobile editor  -->
            <Grid
                Grid.Row="1"
                IsVisible="{Binding MobileShowEditor}"
                RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">

                <Border
                    Grid.Row="0"
                    Margin="8,6,8,4"
                    Padding="6,4"
                    BackgroundColor="{StaticResource ToolbarBg}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeShape="RoundRectangle 8">
                    <ScrollView Orientation="Horizontal">
                        <StackLayout Orientation="Horizontal" Spacing="2">
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="bold"
                                Style="{StaticResource MdBtnStyle}"
                                Text="B" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="italic"
                                FontAttributes="Italic"
                                Style="{StaticResource MdBtnStyle}"
                                Text="I" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="h1"
                                Style="{StaticResource MdBtnStyle}"
                                Text="H1" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="h2"
                                Style="{StaticResource MdBtnStyle}"
                                Text="H2" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="h3"
                                Style="{StaticResource MdBtnStyle}"
                                Text="H3" />

                            <BoxView
                                Margin="4,0"
                                BackgroundColor="{StaticResource BorderColor}"
                                HeightRequest="20"
                                VerticalOptions="Center"
                                WidthRequest="1" />

                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="ulist"
                                Style="{StaticResource MdBtnStyle}"
                                Text="• List" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="olist"
                                Style="{StaticResource MdBtnStyle}"
                                Text="1. List" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="todo"
                                Style="{StaticResource MdBtnStyle}"
                                Text="[ ]" />

                            <BoxView
                                Margin="4,0"
                                BackgroundColor="{StaticResource BorderColor}"
                                HeightRequest="20"
                                VerticalOptions="Center"
                                WidthRequest="1" />

                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="link"
                                Style="{StaticResource MdBtnStyle}"
                                Text="Link" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="code"
                                Style="{StaticResource MdBtnStyle}"
                                Text="``` Code" />
                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="divider"
                                Style="{StaticResource MdBtnStyle}"
                                Text="— Divider" />

                            <BoxView
                                Margin="4,0"
                                BackgroundColor="{StaticResource BorderColor}"
                                HeightRequest="20"
                                VerticalOptions="Center"
                                WidthRequest="1" />

                            <Button
                                Command="{Binding InsertMdCommand}"
                                CommandParameter="tag"
                                Style="{StaticResource MdBtnStyle}"
                                Text="#tag" />
                            <Button
                                Command="{Binding TogglePreviewCommand}"
                                Style="{StaticResource ToolbarBtnStyle}"
                                Text="{Binding IsPreviewMode, Converter={StaticResource BoolToPreviewLabelConverter}}" />
                        </StackLayout>
                    </ScrollView>
                </Border>

                <Border
                    Grid.Row="1"
                    Margin="12,0,12,4"
                    Padding="8,4"
                    BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeShape="RoundRectangle 6">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource MutedStyle}"
                            Text="{Binding SelectedNote.UpdatedAt, StringFormat='обновлено {0:dd MMM, HH:mm}'}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Margin="8,0"
                            Style="{StaticResource MutedStyle}"
                            Text="{Binding AutosaveStatus}" />
                        <Label
                            Grid.Column="2"
                            Style="{StaticResource MutedStyle}"
                            Text="{Binding WordCountText}" />
                    </Grid>
                </Border>

                <Entry
                    Grid.Row="2"
                    Margin="12,0"
                    BackgroundColor="Transparent"
                    FontAttributes="Bold"
                    FontSize="18"
                    Placeholder="Заголовок заметки..."
                    PlaceholderColor="{StaticResource TextMuted}"
                    Text="{Binding EditTitle}"
                    TextColor="{StaticResource TextPrimary}" />

                <!--  Категория (mobile)  -->
                <Border
                    Grid.Row="3"
                    Margin="12,4,12,4"
                    Padding="10,2"
                    BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeShape="RoundRectangle 6">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label
                            Grid.Column="0"
                            FontSize="14"
                            Style="{StaticResource MutedStyle}"
                            Text="Категория"
                            VerticalOptions="Center" />
                        <Picker
                            Grid.Column="1"
                            BackgroundColor="Transparent"
                            FontSize="14"
                            HorizontalOptions="End"
                            ItemDisplayBinding="{Binding Name}"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedNoteCategory}"
                            TextColor="{StaticResource TextPrimary}"
                            WidthRequest="170" />
                    </Grid>
                </Border>

                <ScrollView
                    Grid.Row="4"
                    Padding="12,8"
                    IsVisible="{Binding IsPreviewMode, Converter={StaticResource InverseBoolConverter}}">
                    <Editor
                        AutoSize="TextChanges"
                        MinimumHeightRequest="240"
                        Style="{StaticResource NoteEditorStyle}"
                        Text="{Binding EditContent}" />
                </ScrollView>

                <WebView
                    Grid.Row="4"
                    Margin="12,8"
                    IsVisible="{Binding IsPreviewMode}">
                    <WebView.Source>
                        <HtmlWebViewSource Html="{Binding MarkdownHtml}" />
                    </WebView.Source>
                </WebView>

                <!--  Панель действий (mobile) — иконки в одну строку, экспорт через ActionSheet  -->
                <Border
                    Grid.Row="6"
                    Margin="12,4,12,8"
                    Padding="6"
                    BackgroundColor="{StaticResource BgSecondary}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeShape="RoundRectangle 6">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                        <Button
                            Grid.Column="0"
                            Command="{Binding TogglePinCommand}"
                            FontSize="18"
                            Style="{StaticResource ToolbarBtnStyle}"
                            Text="📌" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding ShowVersionsCommand}"
                            FontSize="18"
                            Style="{StaticResource ToolbarBtnStyle}"
                            Text="🕘" />
                        <Button
                            Grid.Column="2"
                            Clicked="OnMobileExportClicked"
                            FontSize="18"
                            Style="{StaticResource ToolbarBtnStyle}"
                            Text="⬇" />
                        <Button
                            Grid.Column="3"
                            BackgroundColor="#3A1E1E"
                            Command="{Binding DeleteNoteCommand}"
                            CornerRadius="6"
                            FontSize="18"
                            Text="🗑"
                            TextColor="#EF4444" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <ActivityIndicator
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center"
            Color="{StaticResource AccentBlue}" />
    </Grid>
</ContentPage>