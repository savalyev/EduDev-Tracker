<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EduDev_Tracker.Features.Tasks.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:EduDev_Tracker.Features.Tasks.ViewModels"
    Title=""
    x:DataType="vm:TasksViewModel"
    BackgroundColor="#0A0E1A"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#0A0E1A" />
                <GradientStop Offset="0.5" Color="#0D1530" />
                <GradientStop Offset="1" Color="#0A1628" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView x:Name="PageScrollView">
            <Grid
                Padding="0,0,0,24"
                MaximumWidthRequest="1500"
                RowDefinitions="Auto, Auto, Auto, *"
                RowSpacing="16">

                <!--  ═══════════════════════════════════════ ШАПКА  -->
                <Grid
                    Grid.Row="0"
                    Padding="16,16,16,0"
                    RowDefinitions="{OnIdiom Phone='Auto,Auto',
                                             Default='Auto'}"
                    RowSpacing="10">
                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="44, *, Auto"
                        ColumnSpacing="12">

                        <Image
                            HeightRequest="36"
                            HorizontalOptions="Start"
                            IsVisible="{OnIdiom Phone=True,
                                                Default=False}"
                            Source="menu.png"
                            VerticalOptions="Center"
                            WidthRequest="36">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuTapped" />
                            </Image.GestureRecognizers>
                        </Image>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Style="{StaticResource EduCardTitleLabel}" Text="Задачи" />
                            <Label Style="{StaticResource EduCardSubtitleLabel}" Text="{Binding Subtitle}" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="2"
                            Command="{Binding OpenAddTaskCommand}"
                            IsVisible="{OnIdiom Phone=False,
                                                Default=True}"
                            Style="{StaticResource EduPrimaryButton}"
                            Text="+ Новая задача"
                            VerticalOptions="Center" />
                    </Grid>

                    <Button
                        Grid.Row="1"
                        Command="{Binding OpenAddTaskCommand}"
                        HorizontalOptions="Fill"
                        IsVisible="{OnIdiom Phone=True,
                                            Default=False}"
                        Style="{StaticResource EduPrimaryButton}"
                        Text="+ Новая задача" />
                </Grid>

                <!--  ═══════════════════════════════════════ ПЕРЕКЛЮЧАТЕЛЬ РЕЖИМА  -->
                <Grid Grid.Row="1" Padding="16,0,16,0">
                    <HorizontalStackLayout Spacing="4">
                        <!--  Список  -->
                        <Button
                            Command="{Binding SelectViewModeCommand}"
                            CommandParameter="Список"
                            Style="{StaticResource EduFilterButton}"
                            Text="Список">
                            <Button.Triggers>
                                <DataTrigger
                                    Binding="{Binding SelectedViewMode}"
                                    TargetType="Button"
                                    Value="Список">
                                    <Setter Property="BackgroundColor" Value="#5B5FEF" />
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="BorderColor" Value="#7B7FFF" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <!--  Календарь  -->
                        <Button
                            Command="{Binding SelectViewModeCommand}"
                            CommandParameter="Календарь"
                            Style="{StaticResource EduFilterButton}"
                            Text="Календарь">
                            <Button.Triggers>
                                <DataTrigger
                                    Binding="{Binding SelectedViewMode}"
                                    TargetType="Button"
                                    Value="Календарь">
                                    <Setter Property="BackgroundColor" Value="#5B5FEF" />
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="BorderColor" Value="#7B7FFF" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <!--  Канбан  -->
                        <Button
                            Command="{Binding SelectViewModeCommand}"
                            CommandParameter="Канбан"
                            Style="{StaticResource EduFilterButton}"
                            Text="Канбан">
                            <Button.Triggers>
                                <DataTrigger
                                    Binding="{Binding SelectedViewMode}"
                                    TargetType="Button"
                                    Value="Канбан">
                                    <Setter Property="BackgroundColor" Value="#5B5FEF" />
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="BorderColor" Value="#7B7FFF" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </HorizontalStackLayout>
                </Grid>

                <!--  ═══════════════════════════════════════ ФИЛЬТРЫ  -->
                <Grid Grid.Row="2" Padding="16,0,16,0">
                    <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                        <HorizontalStackLayout Spacing="6">

                            <!--  Кнопка «Все»  -->
                            <Button
                                Command="{Binding SelectPriorityFilterCommand}"
                                CommandParameter="Все"
                                Style="{StaticResource EduFilterButton}"
                                Text="Все">
                                <Button.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SelectedPriorityFilter}"
                                        TargetType="Button"
                                        Value="Все">
                                        <Setter Property="BackgroundColor" Value="#5B5FEF" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="#7B7FFF" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <!--  Критичный  -->
                            <Button
                                Command="{Binding SelectPriorityFilterCommand}"
                                CommandParameter="Критичный"
                                Style="{StaticResource EduFilterButton}"
                                Text="Критичный">
                                <Button.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SelectedPriorityFilter}"
                                        TargetType="Button"
                                        Value="Критичный">
                                        <Setter Property="BackgroundColor" Value="#C0392B" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="#E74C3C" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <!--  Высокий  -->
                            <Button
                                Command="{Binding SelectPriorityFilterCommand}"
                                CommandParameter="Высокий"
                                Style="{StaticResource EduFilterButton}"
                                Text="Высокий">
                                <Button.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SelectedPriorityFilter}"
                                        TargetType="Button"
                                        Value="Высокий">
                                        <Setter Property="BackgroundColor" Value="#E67E22" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="#F39C12" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <!--  Средний  -->
                            <Button
                                Command="{Binding SelectPriorityFilterCommand}"
                                CommandParameter="Средний"
                                Style="{StaticResource EduFilterButton}"
                                Text="Средний">
                                <Button.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SelectedPriorityFilter}"
                                        TargetType="Button"
                                        Value="Средний">
                                        <Setter Property="BackgroundColor" Value="#2980B9" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="#3498DB" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <!--  Низкий  -->
                            <Button
                                Command="{Binding SelectPriorityFilterCommand}"
                                CommandParameter="Низкий"
                                Style="{StaticResource EduFilterButton}"
                                Text="Низкий">
                                <Button.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SelectedPriorityFilter}"
                                        TargetType="Button"
                                        Value="Низкий">
                                        <Setter Property="BackgroundColor" Value="#27AE60" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="#2ECC71" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <!--  Просроченные  -->
                            <Button
                                Command="{Binding SelectPriorityFilterCommand}"
                                CommandParameter="Просроченные"
                                Style="{StaticResource EduFilterButton}"
                                Text="Просроченные">
                                <Button.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SelectedPriorityFilter}"
                                        TargetType="Button"
                                        Value="Просроченные">
                                        <Setter Property="BackgroundColor" Value="#8E44AD" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="#9B59B6" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <!--  Категории (динамические)  -->
                        </HorizontalStackLayout>
                    </ScrollView>
                </Grid>

                <!--  ═══════════════════════════════════════ КОНТЕНТ (зависит от режима)  -->
                <Grid
                    Grid.Row="3"
                    Padding="16,0,16,0"
                    RowDefinitions="Auto, Auto, Auto">

                    <!--  ────── РЕЖИМ: СПИСОК ──────  -->
                    <Border
                        Grid.Row="0"
                        Padding="16"
                        IsVisible="{Binding IsListMode}"
                        Style="{StaticResource EduCardBorder}">

                        <Grid RowDefinitions="Auto, Auto, *, Auto" RowSpacing="0">

                            <Label
                                Grid.Row="0"
                                Style="{StaticResource EduCardTitleLabel}"
                                Text="Список задач" />
                            <Label
                                Grid.Row="1"
                                Margin="0,2,0,10"
                                Style="{StaticResource EduCardSubtitleLabel}"
                                Text="{Binding TasksCountText}" />

                            <!--  Группы задач: BindableLayout вместо CollectionView (нативный краш WinUI при CollectionView в ScrollView)  -->
                            <VerticalStackLayout
                                Grid.Row="2"
                                BindableLayout.ItemsSource="{Binding GroupedTasks}"
                                Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TaskGroup">
                                        <VerticalStackLayout Spacing="6">
                                            <!--  Шапка группы  -->
                                            <HorizontalStackLayout
                                                Padding="0,12,0,6"
                                                Spacing="8"
                                                VerticalOptions="Center">
                                                <BoxView
                                                    BackgroundColor="{Binding GroupColor}"
                                                    CornerRadius="4"
                                                    HeightRequest="14"
                                                    VerticalOptions="Center"
                                                    WidthRequest="4" />
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontFamily="Comfortaa"
                                                    FontSize="15"
                                                    Text="{Binding GroupTitle}"
                                                    TextColor="#94A3B8"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <!--  Элементы группы (TaskGroup сам является источником)  -->
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding}" Spacing="6">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TaskItemViewModel">
                                                        <Border
                                                            Background="#10172A"
                                                            Stroke="#495061"
                                                            StrokeThickness="1">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TasksViewModel}}, Path=OpenTaskDetailsCommand}" CommandParameter="{Binding TaskId}" />
                                                            </Border.GestureRecognizers>
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="14" />
                                                            </Border.StrokeShape>

                                                            <Grid
                                                                Padding="12,10"
                                                                ColumnDefinitions="Auto, *, Auto"
                                                                ColumnSpacing="12"
                                                                RowDefinitions="Auto">

                                                                <!--  Чекбокс (checkbox-заменитель)  -->
                                                                <Border
                                                                    Grid.Column="0"
                                                                    BackgroundColor="#0D1525"
                                                                    HeightRequest="28"
                                                                    Stroke="#5B5FEF"
                                                                    StrokeThickness="1.5"
                                                                    VerticalOptions="Center"
                                                                    WidthRequest="28">
                                                                    <Border.StrokeShape>
                                                                        <RoundRectangle CornerRadius="6" />
                                                                    </Border.StrokeShape>
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TasksViewModel}}, Path=ToggleTaskCommand}" CommandParameter="{Binding TaskId}" />
                                                                    </Border.GestureRecognizers>
                                                                    <!--  Галочка при IsCompleted = True  -->
                                                                    <Label
                                                                        FontFamily="Comfortaa"
                                                                        FontSize="14"
                                                                        HorizontalOptions="Center"
                                                                        IsVisible="{Binding IsCompleted}"
                                                                        Text="✓"
                                                                        TextColor="#5B5FEF"
                                                                        VerticalOptions="Center" />
                                                                </Border>

                                                                <!--  Основная инфо  -->
                                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                                    <Label
                                                                        FontFamily="Comfortaa"
                                                                        FontSize="14"
                                                                        LineBreakMode="TailTruncation"
                                                                        Text="{Binding Title}"
                                                                        TextColor="White">
                                                                        <Label.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsCompleted}"
                                                                                TargetType="Label"
                                                                                Value="True">
                                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                <Setter Property="TextColor" Value="#667788" />
                                                                            </DataTrigger>
                                                                        </Label.Triggers>
                                                                    </Label>

                                                                    <!--  Теги: приоритет + категория + дедлайн  -->
                                                                    <FlexLayout
                                                                        Margin="0,4,0,0"
                                                                        Direction="Row"
                                                                        Wrap="Wrap">

                                                                        <!--  Приоритет  -->
                                                                        <Border
                                                                            Margin="0,0,4,4"
                                                                            Padding="6,2"
                                                                            BackgroundColor="{Binding PriorityBgColor}"
                                                                            Stroke="{Binding PriorityBorderColor}"
                                                                            StrokeThickness="1">
                                                                            <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="10" />
                                                                            </Border.StrokeShape>
                                                                            <Label
                                                                                FontFamily="Comfortaa"
                                                                                FontSize="14"
                                                                                Text="{Binding PriorityLabel}"
                                                                                TextColor="#FFFFFF" />
                                                                        </Border>

                                                                        <!--  Категория  -->
                                                                        <Border
                                                                            Margin="0,0,4,4"
                                                                            Padding="6,2"
                                                                            Background="#182333"
                                                                            Stroke="#4A5A6A"
                                                                            StrokeThickness="1">
                                                                            <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="10" />
                                                                            </Border.StrokeShape>
                                                                            <Label
                                                                                FontFamily="Comfortaa"
                                                                                FontSize="14"
                                                                                Text="{Binding CategoryName}"
                                                                                TextColor="#94A3B8" />
                                                                        </Border>

                                                                        <!--  Дедлайн  -->
                                                                        <Border
                                                                            Margin="0,0,4,4"
                                                                            Padding="6,2"
                                                                            BackgroundColor="{Binding DeadlineBgColor}"
                                                                            Stroke="{StaticResource EduBorderStrong}"
                                                                            StrokeThickness="1">
                                                                            <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="10" />
                                                                            </Border.StrokeShape>
                                                                            <Label
                                                                                FontFamily="Comfortaa"
                                                                                FontSize="14"
                                                                                Text="{Binding DeadlineText}"
                                                                                TextColor="{Binding DeadlineTextColor}"
                                                                                VerticalOptions="Center" />
                                                                        </Border>
                                                                    </FlexLayout>
                                                                </VerticalStackLayout>

                                                                <!--  Действия  -->
                                                                <HorizontalStackLayout
                                                                    Grid.Column="2"
                                                                    IsVisible="{OnIdiom Phone=False,
                                                                                        Default=True}"
                                                                    Spacing="6"
                                                                    VerticalOptions="Center">
                                                                    <Button
                                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TasksViewModel}}, Path=OpenReminderCommand}"
                                                                        CommandParameter="{Binding TaskId}"
                                                                        Style="{StaticResource EduFilterButton}"
                                                                        Text="Напоминание" />
                                                                    <Button
                                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TasksViewModel}}, Path=EditTaskCommand}"
                                                                        CommandParameter="{Binding TaskId}"
                                                                        Style="{StaticResource EduFilterButton}"
                                                                        Text="Редактировать" />
                                                                    <Button
                                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TasksViewModel}}, Path=DeleteTaskCommand}"
                                                                        CommandParameter="{Binding TaskId}"
                                                                        Style="{StaticResource EduFilterButton}"
                                                                        Text="Удалить" />
                                                                </HorizontalStackLayout>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <VerticalStackLayout
                                Grid.Row="3"
                                IsVisible="{Binding ListHasMore}"
                                Padding="0,8,0,0"
                                Spacing="4">
                                <Label
                                    FontFamily="Comfortaa"
                                    FontSize="12"
                                    HorizontalOptions="Center"
                                    Text="{Binding ListPageInfo}"
                                    TextColor="#64748B" />
                                <Button
                                    Command="{Binding LoadMoreListCommand}"
                                    Style="{StaticResource EduBaseButton}"
                                    BackgroundColor="{StaticResource EduButtonBackground}"
                                    BorderColor="{StaticResource EduAccent}"
                                    BorderWidth="1"
                                    CornerRadius="10"
                                    FontFamily="Comfortaa"
                                    FontSize="15"
                                    HeightRequest="40"
                                    Text="Загрузить ещё →"
                                    TextColor="White" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!--  ────── РЕЖИМ: КАЛЕНДАРЬ ──────  -->
                    <Border
                        Grid.Row="1"
                        Padding="16"
                        IsVisible="{Binding IsCalendarMode}"
                        Style="{StaticResource EduCardBorder}">

                        <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" RowSpacing="12">

                            <Label
                                Grid.Row="0"
                                Style="{StaticResource EduCardTitleLabel}"
                                Text="Календарь задач" />
                            <Label
                                Grid.Row="1"
                                Style="{StaticResource EduCardSubtitleLabel}"
                                Text="Нажмите день, чтобы увидеть задачи на выбранную дату" />

                            <!--  Навигация по месяцу  -->
                            <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto">
                                <Button
                                    Grid.Column="0"
                                    BackgroundColor="#5B5FEF"
                                    Command="{Binding PrevMonthCommand}"
                                    HeightRequest="36"
                                    Style="{StaticResource EduFilterButton}"
                                    Text="‹"
                                    TextColor="White"
                                    WidthRequest="36" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="Comfortaa"
                                    FontSize="20"
                                    HorizontalOptions="Center"
                                    Text="{Binding CurrentMonthTitle}"
                                    TextColor="White"
                                    VerticalOptions="Center" />
                                <Button
                                    Grid.Column="2"
                                    BackgroundColor="#5B5FEF"
                                    Command="{Binding NextMonthCommand}"
                                    HeightRequest="36"
                                    Style="{StaticResource EduFilterButton}"
                                    Text="›"
                                    TextColor="White"
                                    WidthRequest="36" />
                            </Grid>

                            <!--  Дни недели: шапка  -->
                            <Grid
                                Grid.Row="3"
                                RowDefinitions="Auto, *"
                                RowSpacing="8">

                                <Grid
                                    Grid.Row="0"
                                    ColumnDefinitions="*, *, *, *, *, *, *"
                                    ColumnSpacing="4">
                                    <Label
                                        Grid.Column="0"
                                        FontFamily="Comfortaa"
                                        FontSize="15"
                                        HorizontalTextAlignment="Center"
                                        Text="Пн"
                                        TextColor="#94A3B8" />
                                    <Label
                                        Grid.Column="1"
                                        FontFamily="Comfortaa"
                                        FontSize="15"
                                        HorizontalTextAlignment="Center"
                                        Text="Вт"
                                        TextColor="#94A3B8" />
                                    <Label
                                        Grid.Column="2"
                                        FontFamily="Comfortaa"
                                        FontSize="15"
                                        HorizontalTextAlignment="Center"
                                        Text="Ср"
                                        TextColor="#94A3B8" />
                                    <Label
                                        Grid.Column="3"
                                        FontFamily="Comfortaa"
                                        FontSize="15"
                                        HorizontalTextAlignment="Center"
                                        Text="Чт"
                                        TextColor="#94A3B8" />
                                    <Label
                                        Grid.Column="4"
                                        FontFamily="Comfortaa"
                                        FontSize="15"
                                        HorizontalTextAlignment="Center"
                                        Text="Пт"
                                        TextColor="#94A3B8" />
                                    <Label
                                        Grid.Column="5"
                                        FontFamily="Comfortaa"
                                        FontSize="15"
                                        HorizontalTextAlignment="Center"
                                        Text="Сб"
                                        TextColor="#6699FF" />
                                    <Label
                                        Grid.Column="6"
                                        FontFamily="Comfortaa"
                                        FontSize="15"
                                        HorizontalTextAlignment="Center"
                                        Text="Вс"
                                        TextColor="#FF6B6B" />
                                </Grid>

                                <!--
                                    Сетка дней месяца. HeightRequest ограничивает высоту (6 строк) —
                                    иначе CollectionView в ScrollView мерится бесконечной высотой и роняет рендер WinUI (0xc000027b)
                                -->
                                <CollectionView
                                    Grid.Row="1"
                                    HeightRequest="{OnIdiom Phone=240, Default=340}"
                                    ItemsSource="{Binding CalendarDays}"
                                    SelectionMode="None"
                                    VerticalOptions="Start">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout
                                            HorizontalItemSpacing="4"
                                            Orientation="Vertical"
                                            Span="7"
                                            VerticalItemSpacing="4" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CalendarDayViewModel">
                                            <Border
                                                BackgroundColor="#14182E"
                                                HeightRequest="52"
                                                Stroke="#FFFFFF"
                                                StrokeThickness="0.5">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TasksViewModel}}, Path=SelectCalendarDayCommand}" CommandParameter="{Binding Date}" />
                                                </Border.GestureRecognizers>
                                                <Border.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsToday}"
                                                        TargetType="Border"
                                                        Value="True">
                                                        <Setter Property="Stroke" Value="#5B5FEF" />
                                                        <Setter Property="StrokeThickness" Value="1.5" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsSelected}"
                                                        TargetType="Border"
                                                        Value="True">
                                                        <Setter Property="Background">
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Offset="0.0" Color="#665B5FEF" />
                                                                <GradientStop Offset="1.0" Color="#E60E121E" />
                                                            </LinearGradientBrush>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsOtherMonth}"
                                                        TargetType="Border"
                                                        Value="True">
                                                        <Setter Property="Opacity" Value="0.3" />
                                                    </DataTrigger>
                                                </Border.Triggers>

                                                <VerticalStackLayout
                                                    Padding="4,6"
                                                    HorizontalOptions="Center"
                                                    Spacing="2"
                                                    VerticalOptions="Center">
                                                    <Label
                                                        FontFamily="Comfortaa"
                                                        FontSize="16"
                                                        HorizontalOptions="Center"
                                                        Text="{Binding DayNumber}"
                                                        TextColor="White" />
                                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                                                        <BoxView
                                                            BackgroundColor="#C0392B"
                                                            CornerRadius="3"
                                                            HeightRequest="6"
                                                            IsVisible="{Binding HasCritical}"
                                                            WidthRequest="6" />
                                                        <BoxView
                                                            BackgroundColor="#E67E22"
                                                            CornerRadius="3"
                                                            HeightRequest="6"
                                                            IsVisible="{Binding HasHigh}"
                                                            WidthRequest="6" />
                                                        <BoxView
                                                            BackgroundColor="#5B5FEF"
                                                            CornerRadius="3"
                                                            HeightRequest="6"
                                                            IsVisible="{Binding HasAny}"
                                                            WidthRequest="6" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                            <!--  Задачи выбранного дня — вставляешь ПОСЛЕ CollectionView с сеткой дней  -->
                            <Border
                                Grid.Row="4"
                                Padding="15,15"
                                Background="#0D1525"
                                IsVisible="{Binding SelectedCalendarDate, Converter={StaticResource IsNotNullConverter}}"
                                Stroke="#495061"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8">
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="Comfortaa"
                                        FontSize="16"
                                        Text="{Binding SelectedDayTitle}"
                                        TextColor="White" />
                                    <Label
                                        FontFamily="Comfortaa"
                                        FontSize="14"
                                        IsVisible="{Binding TasksForSelectedDay.Count, Converter={StaticResource ZeroConverter}}"
                                        Text="Задачи на этот день представлены ниже"
                                        TextColor="#94A3B8" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding TasksForSelectedDay}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TaskItemViewModel">
                                                <Border
                                                    Padding="10,8"
                                                    Background="#14182A"
                                                    Stroke="#3D4A5A"
                                                    StrokeThickness="1">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TasksViewModel}}, Path=OpenTaskDetailsCommand}" CommandParameter="{Binding TaskId}" />
                                                    </Border.GestureRecognizers>
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>
                                                    <VerticalStackLayout Spacing="7">
                                                        <Label
                                                            FontFamily="Comfortaa"
                                                            FontSize="15"
                                                            LineBreakMode="TailTruncation"
                                                            Text="{Binding Title}"
                                                            TextColor="White" />
                                                        <HorizontalStackLayout Spacing="5">
                                                            <Border
                                                                Padding="5,2"
                                                                BackgroundColor="{Binding PriorityBgColor}"
                                                                Stroke="{Binding PriorityBorderColor}"
                                                                StrokeThickness="1">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="8" />
                                                                </Border.StrokeShape>
                                                                <Label
                                                                    FontFamily="Comfortaa"
                                                                    FontSize="14"
                                                                    Text="{Binding PriorityLabel}"
                                                                    TextColor="White" />
                                                            </Border>
                                                            <Label
                                                                FontFamily="Comfortaa"
                                                                FontSize="15"
                                                                Text="{Binding DeadlineText}"
                                                                TextColor="{Binding DeadlineTextColor}"
                                                                VerticalOptions="Center" />
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Border>

                    <!--  ────── РЕЖИМ: КАНБАН ──────  -->
                    <Border
                        Grid.Row="2"
                        Padding="16"
                        IsVisible="{Binding IsKanbanMode}"
                        Style="{StaticResource EduCardBorder}">

                        <Grid RowDefinitions="Auto, Auto, *" RowSpacing="5">
                            <Label
                                Grid.Row="0"
                                Style="{StaticResource EduCardTitleLabel}"
                                Text="Канбан-доска" />
                            <Label
                                Grid.Row="1"
                                Style="{StaticResource EduCardSubtitleLabel}"
                                Text="Нажмите на задачу для смены статуса" />

                            <!--  Колонки канбана  -->
                            <Grid
                                Grid.Row="2"
                                ColumnDefinitions="{OnIdiom Phone='*',
                                                            Default='*, *, *, *'}"
                                ColumnSpacing="12"
                                RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto,Auto',
                                                         Default='Auto'}"
                                RowSpacing="12">

                                <!--  Колонка: К выполнению  -->
                                <Border
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Padding="12"
                                    BackgroundColor="#0D1525"
                                    Stroke="#495061"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout Spacing="8">
                                            <BoxView
                                                BackgroundColor="#8E44AD"
                                                CornerRadius="4"
                                                HeightRequest="14"
                                                VerticalOptions="Center"
                                                WidthRequest="4" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontFamily="Comfortaa"
                                                FontSize="16"
                                                Text="К выполнению"
                                                TextColor="White"
                                                VerticalOptions="Center" />
                                            <Border
                                                Padding="6,2"
                                                BackgroundColor="#2D1A3E"
                                                HorizontalOptions="End"
                                                Stroke="#8E44AD"
                                                StrokeThickness="1">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label
                                                    FontFamily="Comfortaa"
                                                    FontSize="15"
                                                    Text="{Binding OpenCount}"
                                                    TextColor="#CC88FF" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding OpenTasks}" Spacing="6">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                                    <Border
                                                        Padding="10,8"
                                                        Background="#14182E"
                                                        Stroke="#3D4A5A"
                                                        StrokeThickness="1">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TasksViewModel}}, Path=OpenTaskDetailsCommand}" CommandParameter="{Binding TaskId}" />
                                                        </Border.GestureRecognizers>
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10" />
                                                        </Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="4">
                                                            <Label
                                                                FontFamily="Comfortaa"
                                                                FontSize="16"
                                                                LineBreakMode="TailTruncation"
                                                                Text="{Binding Title}"
                                                                TextColor="White" />
                                                            <HorizontalStackLayout Spacing="4">
                                                                <Border
                                                                    Padding="5,2"
                                                                    BackgroundColor="{Binding PriorityBgColor}"
                                                                    Stroke="{Binding PriorityBorderColor}"
                                                                    StrokeThickness="1">
                                                                    <Border.StrokeShape>
                                                                        <RoundRectangle CornerRadius="8" />
                                                                    </Border.StrokeShape>
                                                                    <Label
                                                                        FontFamily="Comfortaa"
                                                                        FontSize="14"
                                                                        Text="{Binding PriorityLabel}"
                                                                        TextColor="White" />
                                                                </Border>
                                                                <Label
                                                                    FontFamily="Comfortaa"
                                                                    FontSize="14"
                                                                    Text="{Binding DeadlineText}"
                                                                    TextColor="#94A3B8"
                                                                    VerticalOptions="Center" />
                                                            </HorizontalStackLayout>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout IsVisible="{Binding OpenHasMore}" Spacing="4" Padding="0,4,0,0">
                                            <Label
                                                FontFamily="Comfortaa"
                                                FontSize="12"
                                                HorizontalOptions="Center"
                                                Text="{Binding OpenPageInfo}"
                                                TextColor="#64748B" />
                                            <Button
                                                Command="{Binding LoadMoreOpenCommand}"
                                                BackgroundColor="#1A0D2E"
                                                BorderColor="#8E44AD"
                                                BorderWidth="1"
                                                CornerRadius="10"
                                                FontFamily="Comfortaa"
                                                FontSize="15"
                                                HeightRequest="36"
                                                Text="Загрузить ещё →"
                                                TextColor="#CC88FF" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <!--  Колонка: В процессе  -->
                                <Border
                                    Grid.Row="{OnIdiom Phone=1,
                                                       Default=0}"
                                    Grid.Column="{OnIdiom Phone=0,
                                                          Default=1}"
                                    Padding="12"
                                    BackgroundColor="#0D1525"
                                    Stroke="#495061"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout Spacing="8">
                                            <BoxView
                                                BackgroundColor="#E67E22"
                                                CornerRadius="4"
                                                HeightRequest="14"
                                                VerticalOptions="Center"
                                                WidthRequest="4" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontFamily="Comfortaa"
                                                FontSize="16"
                                                Text="В процессе"
                                                TextColor="White"
                                                VerticalOptions="Center" />
                                            <Border
                                                Padding="6,2"
                                                BackgroundColor="#2E1E0A"
                                                HorizontalOptions="End"
                                                Stroke="#E67E22"
                                                StrokeThickness="1">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label
                                                    FontFamily="Comfortaa"
                                                    FontSize="15"
                                                    Text="{Binding InProgressCount}"
                                                    TextColor="#FFAA44" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding InProgressTasks}" Spacing="6">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                                    <Border
                                                        Padding="10,8"
                                                        Background="#14182A"
                                                        Stroke="#3D4A5A"
                                                        StrokeThickness="1">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TasksViewModel}}, Path=OpenTaskDetailsCommand}" CommandParameter="{Binding TaskId}" />
                                                        </Border.GestureRecognizers>
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10" />
                                                        </Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="4">
                                                            <Label
                                                                FontFamily="Comfortaa"
                                                                FontSize="16"
                                                                LineBreakMode="TailTruncation"
                                                                Text="{Binding Title}"
                                                                TextColor="White" />
                                                            <HorizontalStackLayout Spacing="4">
                                                                <Border
                                                                    Padding="5,2"
                                                                    BackgroundColor="{Binding PriorityBgColor}"
                                                                    Stroke="{Binding PriorityBorderColor}"
                                                                    StrokeThickness="1">
                                                                    <Border.StrokeShape>
                                                                        <RoundRectangle CornerRadius="8" />
                                                                    </Border.StrokeShape>
                                                                    <Label
                                                                        FontFamily="Comfortaa"
                                                                        FontSize="14"
                                                                        Text="{Binding PriorityLabel}"
                                                                        TextColor="White" />
                                                                </Border>
                                                                <Label
                                                                    FontFamily="Comfortaa"
                                                                    FontSize="14"
                                                                    Text="{Binding DeadlineText}"
                                                                    TextColor="#94A3B8"
                                                                    VerticalOptions="Center" />
                                                            </HorizontalStackLayout>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout IsVisible="{Binding InProgressHasMore}" Spacing="4" Padding="0,4,0,0">
                                            <Label
                                                FontFamily="Comfortaa"
                                                FontSize="12"
                                                HorizontalOptions="Center"
                                                Text="{Binding InProgressPageInfo}"
                                                TextColor="#64748B" />
                                            <Button
                                                Command="{Binding LoadMoreInProgressCommand}"
                                                BackgroundColor="#1F1200"
                                                BorderColor="#E67E22"
                                                BorderWidth="1"
                                                CornerRadius="10"
                                                FontFamily="Comfortaa"
                                                FontSize="15"
                                                HeightRequest="36"
                                                Text="Загрузить ещё →"
                                                TextColor="#FF9944" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <!--  Колонка: На проверке  -->
                                <Border
                                    Grid.Row="{OnIdiom Phone=2,
                                                       Default=0}"
                                    Grid.Column="{OnIdiom Phone=0,
                                                          Default=2}"
                                    Padding="12"
                                    BackgroundColor="#0D1525"
                                    Stroke="#495061"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout Spacing="8">
                                            <BoxView
                                                BackgroundColor="#27AE60"
                                                CornerRadius="4"
                                                HeightRequest="14"
                                                VerticalOptions="Center"
                                                WidthRequest="4" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontFamily="Comfortaa"
                                                FontSize="16"
                                                Text="Выполнено"
                                                TextColor="White"
                                                VerticalOptions="Center" />
                                            <Border
                                                Padding="6,2"
                                                BackgroundColor="#0A1E2E"
                                                HorizontalOptions="End"
                                                Stroke="#27AE60"
                                                StrokeThickness="1">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label
                                                    FontFamily="Comfortaa"
                                                    FontSize="15"
                                                    Text="{Binding DoneCount}"
                                                    TextColor="#44AAFF" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DoneTasks}" Spacing="6">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                                    <Border
                                                        Padding="10,8"
                                                        Background="#0C1A12"
                                                        Stroke="#3D4A5A"
                                                        StrokeThickness="1">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TasksViewModel}}, Path=OpenTaskDetailsCommand}" CommandParameter="{Binding TaskId}" />
                                                        </Border.GestureRecognizers>
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10" />
                                                        </Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="4">
                                                            <Label
                                                                FontFamily="Comfortaa"
                                                                FontSize="16"
                                                                LineBreakMode="TailTruncation"
                                                                Text="{Binding Title}"
                                                                TextColor="White" />
                                                            <HorizontalStackLayout Spacing="4">
                                                                <Border
                                                                    Padding="5,2"
                                                                    BackgroundColor="{Binding PriorityBgColor}"
                                                                    Stroke="{Binding PriorityBorderColor}"
                                                                    StrokeThickness="1">
                                                                    <Border.StrokeShape>
                                                                        <RoundRectangle CornerRadius="8" />
                                                                    </Border.StrokeShape>
                                                                    <Label
                                                                        FontFamily="Comfortaa"
                                                                        FontSize="14"
                                                                        Text="{Binding PriorityLabel}"
                                                                        TextColor="White" />
                                                                </Border>
                                                                <Label
                                                                    FontFamily="Comfortaa"
                                                                    FontSize="14"
                                                                    Text="{Binding DeadlineText}"
                                                                    TextColor="#94A3B8"
                                                                    VerticalOptions="Center" />
                                                            </HorizontalStackLayout>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <!--  Подгрузить ещё выполненные  -->
                                        <VerticalStackLayout IsVisible="{Binding DoneHasMore}" Spacing="6">
                                            <Label
                                                FontFamily="Comfortaa"
                                                FontSize="12"
                                                HorizontalOptions="Center"
                                                Text="{Binding DonePageInfo}"
                                                TextColor="#64748B" />
                                            <Button
                                                Command="{Binding LoadMoreDoneCommand}"
                                                FontFamily="Comfortaa"
                                                FontSize="15"
                                                BackgroundColor="#0D1F12"
                                                BorderColor="#27AE60"
                                                BorderWidth="1"
                                                CornerRadius="10"
                                                HeightRequest="36"
                                                Text="Загрузить ещё 15 →"
                                                TextColor="#44CC77" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <!--  Колонка: Отменено  -->
                                <Border
                                    Grid.Row="{OnIdiom Phone=3,
                                                       Default=0}"
                                    Grid.Column="{OnIdiom Phone=0,
                                                          Default=3}"
                                    Padding="12"
                                    BackgroundColor="#0D1525"
                                    Stroke="#495061"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout Spacing="8">
                                            <BoxView
                                                BackgroundColor="Red"
                                                CornerRadius="4"
                                                HeightRequest="14"
                                                VerticalOptions="Center"
                                                WidthRequest="4" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontFamily="Comfortaa"
                                                FontSize="16"
                                                Text="Отменено"
                                                TextColor="White"
                                                VerticalOptions="Center" />
                                            <Border
                                                Padding="6,2"
                                                BackgroundColor="#0A2018"
                                                HorizontalOptions="End"
                                                Stroke="Red"
                                                StrokeThickness="1">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label
                                                    FontFamily="Comfortaa"
                                                    FontSize="15"
                                                    Text="{Binding CancelledCount}"
                                                    TextColor="Red" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CancelledTasks}" Spacing="6">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                                    <Border
                                                        Padding="10,8"
                                                        Background="#14182A"
                                                        Stroke="#3D4A5A"
                                                        StrokeThickness="1">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TasksViewModel}}, Path=OpenTaskDetailsCommand}" CommandParameter="{Binding TaskId}" />
                                                        </Border.GestureRecognizers>
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10" />
                                                        </Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="4">
                                                            <Label
                                                                FontFamily="Comfortaa"
                                                                FontSize="16"
                                                                LineBreakMode="TailTruncation"
                                                                Text="{Binding Title}"
                                                                TextColor="#667788"
                                                                TextDecorations="Strikethrough" />
                                                            <HorizontalStackLayout Spacing="4">
                                                                <Border
                                                                    Padding="5,2"
                                                                    BackgroundColor="{Binding PriorityBgColor}"
                                                                    Stroke="{Binding PriorityBorderColor}"
                                                                    StrokeThickness="1">
                                                                    <Border.StrokeShape>
                                                                        <RoundRectangle CornerRadius="8" />
                                                                    </Border.StrokeShape>
                                                                    <Label
                                                                        FontFamily="Comfortaa"
                                                                        FontSize="15"
                                                                        Text="{Binding PriorityLabel}"
                                                                        TextColor="White" />
                                                                </Border>
                                                                <Label
                                                                    FontFamily="Comfortaa"
                                                                    FontSize="14"
                                                                    Text="{Binding DeadlineText}"
                                                                    TextColor="#94A3B8"
                                                                    VerticalOptions="Center" />
                                                            </HorizontalStackLayout>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <!--  Подгрузить ещё отменённые  -->
                                        <VerticalStackLayout IsVisible="{Binding CancelledHasMore}" Spacing="6">
                                            <Label
                                                FontFamily="Comfortaa"
                                                FontSize="12"
                                                HorizontalOptions="Center"
                                                Text="{Binding CancelledPageInfo}"
                                                TextColor="#64748B" />
                                            <Button
                                                Command="{Binding LoadMoreCancelledCommand}"
                                                FontFamily="Comfortaa"
                                                FontSize="15"
                                                BackgroundColor="#1A0D0D"
                                                BorderColor="#C0392B"
                                                BorderWidth="1"
                                                CornerRadius="10"
                                                HeightRequest="36"
                                                Text="Загрузить ещё 15 →"
                                                TextColor="#FF6666" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollView>

        <!--  FAB: кнопка добавить задачу (только телефон)  -->
        <Button
            Margin="16,0,16,16"
            Command="{Binding OpenAddTaskCommand}"
            HeightRequest="48"
            HorizontalOptions="Fill"
            IsVisible="{OnIdiom Phone=True,
                                Default=False}"
            Style="{StaticResource EduPrimaryButton}"
            Text="+ Новая задача"
            VerticalOptions="End" />
    </Grid>
</ContentPage>
