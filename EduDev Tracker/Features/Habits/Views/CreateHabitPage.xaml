<?xml version="1.0" encoding="utf-8" ?>
<local:AnimatedModalPage
    x:Class="EduDev_Tracker.Features.Habits.Views.CreateHabitPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:EduDev_Tracker.Core.Helpers"
    xmlns:viewmodels="clr-namespace:EduDev_Tracker.Features.Habits.ViewModels"
    x:DataType="viewmodels:CreateHabitViewModel"
    BackgroundImageSource="background_gradient.jpg">

    <ScrollView>
        <Grid
            Padding="16"
            HorizontalOptions="Center"
            VerticalOptions="Start">

            <Border
                Padding="24"
                HorizontalOptions="Fill"
                MaximumWidthRequest="520"
                Style="{StaticResource EduCardBorder}">

                <VerticalStackLayout Spacing="10">

                    <Label
                        FontSize="24"
                        Style="{StaticResource EduCardTitleLabel}"
                        Text="Добавить привычку" />
                    <Label Style="{StaticResource EduProgressSubtitleLabel}" Text="Создайте новую привычку" />

                    <Image HeightRequest="2" Source="dividing_strip.png" />

                    <Label Style="{StaticResource EduCardTitle16}" Text="Название привычки" />
                    <Editor
                        BackgroundColor="#14182E"
                        FontFamily="Comfortaa"
                        FontSize="14"
                        HeightRequest="40"
                        Placeholder="Например: утренняя зарядка"
                        PlaceholderColor="#66FFFFFF"
                        Text="{Binding Title}"
                        TextColor="White"
                        VerticalTextAlignment="Center" />

                    <Label Style="{StaticResource EduCardTitle16}" Text="Описание" />
                    <Editor
                        BackgroundColor="#14182E"
                        FontFamily="Comfortaa"
                        FontSize="14"
                        HeightRequest="72"
                        Placeholder="Цель: 30 минут в день перед сном"
                        PlaceholderColor="#66FFFFFF"
                        Text="{Binding Description}"
                        TextColor="White" />

                    <Label
                        Style="{StaticResource EduCardTitle16}"
                        Text="Тип привычки"
                        VerticalOptions="Center" />
                    <Picker
                        BackgroundColor="#14182E"
                        FontFamily="Comfortaa"
                        FontSize="14"
                        HeightRequest="48"
                        ItemDisplayBinding="{Binding Title}"
                        ItemsSource="{Binding HabitTypes}"
                        SelectedIndexChanged="Picker_SelectedIndexChanged"
                        SelectedItem="{Binding SelectedHabitType, Mode=TwoWay}"
                        TextColor="White"
                        TitleColor="#66FFFFFF" />

                    <Label Style="{StaticResource EduCardTitle16}" Text="Повторяемость" />
                    <FlexLayout
                        AlignItems="Center"
                        BindableLayout.ItemsSource="{Binding WeekDays}"
                        Direction="Row"
                        JustifyContent="Start"
                        Wrap="Wrap">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:DayItem">
                                <Border
                                    Margin="0,0,8,8"
                                    BackgroundColor="{Binding BackgroundColor}"
                                    HeightRequest="42"
                                    Stroke="{Binding BorderColor}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="1"
                                    WidthRequest="42">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CreateHabitViewModel}}, Path=ToggleDayCommand}" CommandParameter="{Binding Name}" />
                                    </Border.GestureRecognizers>

                                    <Label
                                        FontFamily="Comfortaa"
                                        FontSize="13"
                                        HorizontalOptions="Center"
                                        Text="{Binding Name}"
                                        TextColor="{Binding TextColor}"
                                        VerticalOptions="Center" />

                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Label
                        Style="{StaticResource EduCardTitle16}"
                        Text="Напоминание"
                        VerticalOptions="Center" />
                    <TimePicker
                        BackgroundColor="#14182E"
                        FontFamily="Comfortaa"
                        FontSize="16"
                        Format="HH:mm"
                        HeightRequest="48"
                        HorizontalOptions="Start"
                        TextColor="White"
                        Time="{Binding ReminderTime}" />

                    <Label
                        x:Name="LabelTargetValue"
                        Style="{StaticResource EduCardTitle16}"
                        Text="Целевое значение" />
                    <Editor
                        x:Name="EditorTargetValue"
                        BackgroundColor="#14182E"
                        FontFamily="Comfortaa"
                        FontSize="14"
                        HeightRequest="40"
                        Placeholder="Например: 20"
                        PlaceholderColor="#66FFFFFF"
                        Text="{Binding TargetValue}"
                        TextColor="White"
                        VerticalTextAlignment="Center" />

                    <Label
                        x:Name="LabelTargetUnit"
                        Style="{StaticResource EduCardTitle16}"
                        Text="Единица измерения" />
                    <Editor
                        x:Name="EditorTargetUnit"
                        BackgroundColor="#14182E"
                        FontFamily="Comfortaa"
                        FontSize="14"
                        HeightRequest="40"
                        Placeholder="Например: отжиманий"
                        PlaceholderColor="#66FFFFFF"
                        Text="{Binding TargetUnit}"
                        TextColor="White"
                        VerticalTextAlignment="Center" />

                    <Image HeightRequest="2" Source="dividing_strip.png" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Button
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource EduPrimaryButton}"
                            Text="Отменить" />

                        <Button
                            Grid.Column="1"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource EduPrimaryButton}"
                            Text="Сохранить" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</local:AnimatedModalPage>