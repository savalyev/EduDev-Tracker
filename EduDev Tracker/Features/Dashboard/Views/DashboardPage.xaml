<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EduDev_Tracker.Features.Dashboard.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EduDev_Tracker.Features.Dashboard.ViewModels"
    Title=""
    x:DataType="vm:DashboardViewModel"
    BackgroundColor="#0A0E1A"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#0A0E1A" />
                    <GradientStop Offset="0.5" Color="#0D1530" />
                    <GradientStop Offset="1" Color="#0A1628" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid
                x:Name="ContentGrid"
                Padding="16"
                HorizontalOptions="Center"
                MaximumWidthRequest="1100"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                RowSpacing="14"
                VerticalOptions="Start">

                <!--  ══ ШАПКА: приветствие + дата + лого ═══════════════════  -->
                <Grid
                    Padding="{OnIdiom Phone='12,10',
                                      Default='0'}"
                    BackgroundColor="{OnIdiom Phone=#0F1629,
                                              Default=Transparent}"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="12">

                    <Image
                        HeightRequest="44"
                        HorizontalOptions="Start"
                        IsVisible="{OnIdiom Phone=True,
                                            Default=False}"
                        Source="menu.png"
                        VerticalOptions="Center"
                        WidthRequest="44">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuTapped" />
                        </Image.GestureRecognizers>
                    </Image>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Padding="4,0"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontFamily="Comfortaa"
                            FontSize="22"
                            Text="{Binding GreetingText}"
                            TextColor="White" />
                        <Label
                            FontFamily="Comfortaa"
                            FontSize="15"
                            Text="{Binding DateText}"
                            TextColor="#8892A4" />
                    </VerticalStackLayout>

                    <Image
                        Grid.Column="2"
                        HeightRequest="52"
                        HorizontalOptions="End"
                        Source="logo.png"
                        VerticalOptions="Center"
                        WidthRequest="52" />
                </Grid>

                <!--  ══ ПРОГРЕСС НЕДЕЛИ ════════════════════════════════════  -->
                <Border Grid.Row="2" Style="{StaticResource EduCardBorder}">

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">

                        <VerticalStackLayout>
                            <Label Style="{StaticResource EduCardTitle16}" Text="Прогресс недели" />
                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontFamily="Comfortaa"
                            FontSize="22"
                            Text="{Binding WeekProgressText}"
                            TextColor="{StaticResource EduAccent}"
                            VerticalOptions="Center" />

                        <ProgressBar
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,16,0,0"
                            BackgroundColor="{StaticResource EduBorder}"
                            Progress="{Binding WeekProgress}"
                            ProgressColor="{StaticResource EduAccent}" />

                        <Grid
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Margin="0,12,0,0"
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="8">

                            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="Comfortaa"
                                    FontSize="26"
                                    HorizontalOptions="Center"
                                    Text="{Binding HabitsCompletedWeek}"
                                    TextColor="{StaticResource EduSuccess}" />
                                <Label
                                    FontFamily="Comfortaa"
                                    FontSize="15"
                                    HorizontalOptions="Center"
                                    Text="Привычек"
                                    TextColor="{StaticResource EduMutedText}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="1"
                                HorizontalOptions="Center"
                                Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="Comfortaa"
                                    FontSize="26"
                                    HorizontalOptions="Center"
                                    Text="{Binding TasksClosedWeek}"
                                    TextColor="{StaticResource EduInfo}" />
                                <Label
                                    FontFamily="Comfortaa"
                                    FontSize="15"
                                    HorizontalOptions="Center"
                                    Text="Задач"
                                    TextColor="{StaticResource EduMutedText}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="2"
                                HorizontalOptions="Center"
                                Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="Comfortaa"
                                    FontSize="26"
                                    HorizontalOptions="Center"
                                    Text="{Binding PomodoroWeek}"
                                    TextColor="{StaticResource EduWarning}" />
                                <Label
                                    FontFamily="Comfortaa"
                                    FontSize="15"
                                    HorizontalOptions="Center"
                                    Text="Помодоро"
                                    TextColor="{StaticResource EduMutedText}" />
                            </VerticalStackLayout>

                        </Grid>
                    </Grid>
                </Border>

                <!--  ══ КАРТОЧКИ МОДУЛЕЙ ════════════════════════════════════  -->
                <Grid
                    x:Name="CardsGrid"
                    Grid.Row="3"
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="16"
                    RowDefinitions="Auto"
                    RowSpacing="16">
                    <!--  Привычки  -->
                    <Border
                        x:Name="HabitsCard"
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource EduCardBorder}">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto,Auto,Auto,*"
                            RowSpacing="10">

                            <Label
                                Grid.ColumnSpan="2"
                                Style="{StaticResource EduCardSubtitleLabel}"
                                Text="{Binding HabitsSubtitle}" />

                            <Label
                                Grid.Row="1"
                                FontAttributes="Bold"
                                FontFamily="Comfortaa"
                                FontSize="22"
                                Text="Привычки"
                                TextColor="White" />

                            <Image
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Source="dividing_strip.png" />

                            <Label
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource EduCardSubtitleLabel}"
                                Text="Пора повышать свою продуктивность! Смело добавляйте новые привычки и отмечайте выполнение!" />

                            <Grid
                                Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Margin="0,16,0,0"
                                ColumnDefinitions="*,Auto"
                                VerticalOptions="End">

                                <Button
                                    BackgroundColor="{StaticResource EduButtonBackground}"
                                    BorderColor="{StaticResource EduAccent}"
                                    BorderWidth="1"
                                    Command="{Binding GoToHabitsCommand}"
                                    CornerRadius="12"
                                    FontFamily="Comfortaa"
                                    FontSize="15"
                                    HeightRequest="40"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource EduBaseButton}"
                                    Text="→ Перейти"
                                    TextColor="White"
                                    VerticalOptions="Center"
                                    WidthRequest="130" />

                                <ImageButton
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    Command="{Binding QuickAddHabitCommand}"
                                    HeightRequest="44"
                                    Source="add_icon.png"
                                    VerticalOptions="Center"
                                    WidthRequest="44" />
                            </Grid>

                        </Grid>
                    </Border>

                    <!--  Задачи  -->
                    <Border
                        x:Name="TasksCard"
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource EduCardBorder}">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto,Auto,Auto,*"
                            RowSpacing="10">

                            <Label
                                Grid.ColumnSpan="2"
                                Style="{StaticResource EduCardSubtitleLabel}"
                                Text="{Binding TasksSubtitle}" />

                            <Label
                                Grid.Row="1"
                                FontAttributes="Bold"
                                FontFamily="Comfortaa"
                                FontSize="22"
                                Text="Задачи"
                                TextColor="White" />

                            <Image
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Source="dividing_strip.png" />

                            <Label
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource EduCardSubtitleLabel}"
                                Text="У Вас есть задачи, которые нужно отслеживать? Создавайте умный список задач и следите за своей работой!" />

                            <Grid
                                Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Margin="0,16,0,0"
                                ColumnDefinitions="*,Auto"
                                VerticalOptions="End">

                                <Button
                                    BackgroundColor="{StaticResource EduButtonBackground}"
                                    BorderColor="{StaticResource EduAccent}"
                                    BorderWidth="1"
                                    Command="{Binding GoToTasksCommand}"
                                    CornerRadius="12"
                                    FontFamily="Comfortaa"
                                    FontSize="15"
                                    HeightRequest="40"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource EduBaseButton}"
                                    Text="→ Перейти"
                                    TextColor="White"
                                    VerticalOptions="Start"
                                    WidthRequest="130" />

                                <ImageButton
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    Command="{Binding QuickAddTaskCommand}"
                                    HeightRequest="44"
                                    Source="add_icon.png"
                                    VerticalOptions="Center"
                                    WidthRequest="44" />
                            </Grid>

                        </Grid>
                    </Border>

                    <!--  Сегодняшние задачи  -->
                    <Border
                        x:Name="TodayTasksCard"
                        Grid.Row="0"
                        Grid.Column="2"
                        MinimumHeightRequest="200"
                        Style="{StaticResource EduCardBorder}">
                        <Grid RowDefinitions="Auto,*">

                            <Label
                                FontAttributes="Bold"
                                FontFamily="Comfortaa"
                                FontSize="16"
                                Text="Сегодняшние задачи"
                                TextColor="White" />

                            <!--  Пустое состояние  -->
                            <Border
                                Grid.Row="1"
                                Margin="0,10,0,0"
                                IsVisible="{Binding HasTodayTasks, Converter={StaticResource InverseBool}}"
                                Style="{StaticResource EduEmptyStateBorder}">
                                <Label
                                    FontFamily="Comfortaa"
                                    FontSize="14"
                                    HorizontalTextAlignment="Center"
                                    Opacity="0.4"
                                    Text="Задач на сегодня нет"
                                    TextColor="White"
                                    VerticalOptions="Center" />
                            </Border>

                            <!--  Список задач  -->
                            <CollectionView
                                Grid.Row="1"
                                Margin="0,10,0,0"
                                IsVisible="{Binding HasTodayTasks}"
                                ItemsSource="{Binding TodayTasks}"
                                SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TodayTaskItem">
                                        <Grid
                                            Padding="0,6"
                                            ColumnDefinitions="8,*"
                                            ColumnSpacing="10">
                                            <BoxView
                                                BackgroundColor="{Binding PriorityColor}"
                                                CornerRadius="4"
                                                VerticalOptions="Fill"
                                                WidthRequest="4" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="Comfortaa"
                                                FontSize="15"
                                                Text="{Binding Title}"
                                                TextColor="White"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </Grid>
                    </Border>

                    <!--  VisualStateManager — переключение Narrow/Wide  -->
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="WidthStates">
                            <VisualState x:Name="Narrow">
                                <VisualState.Setters>
                                    <Setter TargetName="CardsGrid" Property="ColumnDefinitions" Value="*" />
                                    <Setter TargetName="CardsGrid" Property="RowDefinitions" Value="Auto,Auto,Auto" />
                                    <Setter TargetName="HabitsCard" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="HabitsCard" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="TasksCard" Property="Grid.Row" Value="1" />
                                    <Setter TargetName="TasksCard" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="TodayTasksCard" Property="Grid.Row" Value="2" />
                                    <Setter TargetName="TodayTasksCard" Property="Grid.Column" Value="0" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Wide">
                                <VisualState.Setters>
                                    <Setter TargetName="CardsGrid" Property="ColumnDefinitions" Value="*,*,*" />
                                    <Setter TargetName="CardsGrid" Property="RowDefinitions" Value="Auto" />
                                    <Setter TargetName="HabitsCard" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="HabitsCard" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="TasksCard" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="TasksCard" Property="Grid.Column" Value="1" />
                                    <Setter TargetName="TodayTasksCard" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="TodayTasksCard" Property="Grid.Column" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>

                <!--  ══ НИЖНИЙ РЯД: ГРАФИК + ФОКУС ══════════════════════════  -->
                <Grid
                    Grid.Row="4"
                    Margin="0,0,0,16"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="16">

                    <!--  График активности  -->
                    <Border Style="{StaticResource EduCardBorder}">
                        <Grid RowDefinitions="Auto,Auto">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Style="{StaticResource EduCardTitle16}"
                                    Text="Продуктивность за 7 дней"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="Comfortaa"
                                    FontSize="14"
                                    Text="Подробнее →"
                                    TextColor="#8892A4"
                                    VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToAnalyticsCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <CollectionView
                                Grid.Row="1"
                                Margin="0,20,0,0"
                                HeightRequest="150"
                                ItemsSource="{Binding WeekChart}"
                                SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="6" Orientation="Horizontal" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WeekBarPoint">
                                        <VerticalStackLayout
                                            Spacing="6"
                                            VerticalOptions="End"
                                            WidthRequest="38">
                                            <Border
                                                BackgroundColor="{Binding BarColor}"
                                                HeightRequest="{Binding BarHeight}"
                                                HorizontalOptions="Center"
                                                StrokeShape="RoundRectangle 5"
                                                StrokeThickness="0"
                                                WidthRequest="26">
                                                <BoxView HeightRequest="0" />
                                            </Border>
                                            <Label
                                                FontFamily="Comfortaa"
                                                FontSize="15"
                                                HorizontalOptions="Center"
                                                Text="{Binding DayLabel}"
                                                TextColor="{Binding DayLabelColor}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </Grid>
                    </Border>

                    <!--  Фокус  -->
                    <Border Grid.Row="1" Style="{StaticResource EduCardBorder}">
                        <VerticalStackLayout Spacing="10">

                            <Label Style="{StaticResource EduCardTitle16}" Text="Фокус" />
                            <Image Source="dividing_strip.png" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource EduSmallLabelMuted}" Text="Сегодня" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource EduSmallLabel}"
                                    Text="{Binding TodayFocusText}" />
                            </Grid>
                            <Image Source="dividing_strip.png" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource EduSmallLabelMuted}" Text="Сессий" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource EduSmallLabel}"
                                    Text="{Binding TodaySessionsCount}" />
                            </Grid>
                            <Image Source="dividing_strip.png" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource EduSmallLabelMuted}" Text="Активный цикл" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource EduSmallLabel}"
                                    Text="{Binding ActivePresetLabel}" />
                            </Grid>
                            <Image Source="dividing_strip.png" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource EduSmallLabelMuted}" Text="Запустить Помодоро" />
                                <Image
                                    Grid.Column="1"
                                    HeightRequest="14"
                                    Source="start_icon.png"
                                    VerticalOptions="Center"
                                    WidthRequest="14">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding StartPomodoroCommand}" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
