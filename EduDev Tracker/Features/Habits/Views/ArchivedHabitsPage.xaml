<?xml version="1.0" encoding="utf-8" ?>
<local:AnimatedModalPage
    x:Class="EduDev_Tracker.Features.Habits.Views.ArchivedHabitsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:EduDev_Tracker.Core.Helpers"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:EduDev_Tracker.Features.Habits.ViewModels"
    Title=""
    x:DataType="vm:ArchivedHabitsViewModel"
    BackgroundColor="#0A0E1A"
    Shell.NavBarIsVisible="False">


    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#0A0E1A" />
                <GradientStop Offset="0.5" Color="#0D1530" />
                <GradientStop Offset="1" Color="#0A1628" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid
            Padding="20"
            RowDefinitions="Auto, *"
            RowSpacing="16">

            <!--  Шапка  -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label
                        FontFamily="Comfortaa"
                        FontSize="20"
                        Text="Архив привычек"
                        TextColor="White" />
                    <Label
                        FontFamily="Comfortaa"
                        FontSize="14"
                        Text="Восстановите или удалите заархивированные привычки"
                        TextColor="#99FFFFFF" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource EduPrimaryButton}"
                    Text="✕ Закрыть"
                    VerticalOptions="Center" />
            </Grid>

            <!--  Контент  -->
            <Grid Grid.Row="1">

                <!--  Пустое состояние  -->
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsEmpty}"
                    Spacing="12"
                    VerticalOptions="Center">
                    <Label
                        FontFamily="Comfortaa"
                        FontSize="36"
                        HorizontalOptions="Center"
                        Text="Архив пуст"
                        TextColor="White" />
                    <Label
                        FontFamily="Comfortaa"
                        FontSize="16"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="Заархивированные привычки появятся здесь"
                        TextColor="#99FFFFFF" />
                </VerticalStackLayout>

                <!--  Список  -->
                <CollectionView
                    IsVisible="{Binding IsNotEmpty}"
                    ItemsSource="{Binding ArchivedHabits}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ArchivedHabitItem">
                            <Border
                                Padding="14"
                                Background="#10172A"
                                Stroke="#495061"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Grid RowDefinitions="Auto, Auto" RowSpacing="12">

                                    <!--  Верхняя строка: иконка + инфо  -->
                                    <Grid
                                        Grid.Row="0"
                                        ColumnDefinitions="52, *"
                                        ColumnSpacing="12">

                                        <Border
                                            Padding="10"
                                            Background="#1D3A3A"
                                            HeightRequest="52"
                                            Stroke="#996EE7B7"
                                            WidthRequest="52">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Image Aspect="AspectFit" Source="{Binding Icon}" />
                                        </Border>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="4"
                                            VerticalOptions="Center">
                                            <Label
                                                FontFamily="Comfortaa"
                                                FontSize="15"
                                                Text="{Binding Title}"
                                                TextColor="White" />
                                            <Label
                                                FontFamily="Comfortaa"
                                                FontSize="11"
                                                Text="{Binding Description}"
                                                TextColor="#99FFFFFF" />
                                            <HorizontalStackLayout Spacing="8">
                                                <Border
                                                    Padding="6,2"
                                                    Background="#182333"
                                                    Stroke="#4A5A6A"
                                                    StrokeThickness="1">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                        FontFamily="Comfortaa"
                                                        FontSize="10"
                                                        Text="{Binding Type}"
                                                        TextColor="#99FFFFFF" />
                                                </Border>
                                                <Label
                                                    FontFamily="Comfortaa"
                                                    FontSize="10"
                                                    Text="{Binding ArchivedDate, StringFormat='Архив: {0}'}"
                                                    TextColor="#99FFFFFF"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!--  Нижняя строка: кнопки  -->
                                    <Grid
                                        Grid.Row="1"
                                        ColumnDefinitions="*, *"
                                        ColumnSpacing="10">
                                        <Button
                                            Grid.Column="0"
                                            BackgroundColor="#1D3A2A"
                                            BorderColor="#996EE7B7"
                                            BorderWidth="1"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArchivedHabitsViewModel}}, Path=RestoreCommand}"
                                            CommandParameter="{Binding HabitId}"
                                            CornerRadius="12"
                                            FontFamily="Comfortaa"
                                            FontSize="15"
                                            HeightRequest="40"
                                            Text="Восстановить"
                                            TextColor="#6EE7B7" />
                                        <Button
                                            Grid.Column="1"
                                            BackgroundColor="#2A1020"
                                            BorderColor="#7A2040"
                                            BorderWidth="1"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArchivedHabitsViewModel}}, Path=DeleteForeverCommand}"
                                            CommandParameter="{Binding HabitId}"
                                            CornerRadius="12"
                                            FontFamily="Comfortaa"
                                            FontSize="15"
                                            HeightRequest="40"
                                            Text="Удалить"
                                            TextColor="#FF6B8A" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
    </Grid>
</local:AnimatedModalPage>