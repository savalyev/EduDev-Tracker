<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EduDev_Tracker.Features.Profile.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EduDev_Tracker.Features.Profile.ViewModels"
    Title=""
    x:DataType="vm:ProfileViewModel"
    BackgroundColor="#0A0E1A"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#0A0E1A" />
                    <GradientStop Offset="0.5" Color="#0D1530" />
                    <GradientStop Offset="1" Color="#0A1628" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid
                Padding="16"
                HorizontalOptions="Center"
                MaximumWidthRequest="700"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                RowSpacing="14"
                VerticalOptions="Start">

                <!--  ══ ШАПКА ══════════════════════════════════════════════  -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image
                        HeightRequest="40"
                        HorizontalOptions="Start"
                        IsVisible="{OnIdiom Phone=True, Default=False}"
                        Source="menu.png"
                        VerticalOptions="Center"
                        WidthRequest="40">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontFamily="Comfortaa"
                        FontSize="22"
                        Text="Профиль"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Grid>

                <!--  ══ КАРТОЧКА ПРОФИЛЯ ═══════════════════════════════════  -->
                <Border Grid.Row="1" Style="{StaticResource EduCardBorder}">
                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="16"
                        RowDefinitions="Auto">

                        <!--  Аватар — цветной круг с инициалами  -->
                        <Border
                            BackgroundColor="{Binding AvatarColor}"
                            HeightRequest="80"
                            HorizontalOptions="Start"
                            StrokeShape="RoundRectangle 40"
                            StrokeThickness="0"
                            VerticalOptions="Start"
                            WidthRequest="80">
                            <Label
                                FontAttributes="Bold"
                                FontFamily="Comfortaa"
                                FontSize="24"
                                HorizontalOptions="Center"
                                Text="{Binding AvatarInitials}"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Информация  -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5"
                            VerticalOptions="Center">

                            <Label
                                FontAttributes="Bold"
                                FontFamily="Comfortaa"
                                FontSize="20"
                                LineBreakMode="TailTruncation"
                                Text="{Binding UserName}"
                                TextColor="White" />

                            <Label
                                FontSize="13"
                                LineBreakMode="TailTruncation"
                                Text="{Binding UserEmail}"
                                TextColor="{StaticResource EduMutedText}" />

                            <!--  Бейдж типа аккаунта  -->
                            <Border
                                BackgroundColor="{Binding AccountTypeBg}"
                                HorizontalOptions="Start"
                                Padding="10,5"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0">
                                <Label
                                    FontFamily="Comfortaa"
                                    FontSize="13"
                                    Text="{Binding AccountTypeLabel}"
                                    TextColor="{Binding AccountTypeColor}" />
                            </Border>

                            <Label
                                FontSize="13"
                                Text="{Binding MemberSince, StringFormat='Участник с {0}'}"
                                TextColor="{StaticResource EduMutedText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--  ══ СТАТИСТИКА ═════════════════════════════════════════  -->
                <Grid
                    Grid.Row="2"
                    ColumnDefinitions="{OnIdiom Phone='*,*', Default='*,*,*,*'}"
                    ColumnSpacing="12"
                    RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                    RowSpacing="12">

                    <!--  Привычки  -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="16,20"
                        BackgroundColor="{StaticResource EduSurfaceAlt}"
                        Stroke="{StaticResource EduBorder}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontFamily="Comfortaa"
                                FontSize="28"
                                HorizontalOptions="Center"
                                Text="{Binding HabitsCount}"
                                TextColor="{StaticResource EduSuccess}" />
                            <Label
                                FontFamily="Comfortaa"
                                FontSize="14"
                                HorizontalOptions="Center"
                                Opacity="0.7"
                                Text="Привычки"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  Задачи  -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="16,20"
                        BackgroundColor="{StaticResource EduSurfaceAlt}"
                        Stroke="{StaticResource EduBorder}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontFamily="Comfortaa"
                                FontSize="28"
                                HorizontalOptions="Center"
                                Text="{Binding TasksCount}"
                                TextColor="{StaticResource EduInfo}" />
                            <Label
                                FontFamily="Comfortaa"
                                FontSize="14"
                                HorizontalOptions="Center"
                                Opacity="0.7"
                                Text="Задачи"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  Заметки (адаптивная позиция)  -->
                    <Border
                        Grid.Row="{OnIdiom Phone=1, Default=0}"
                        Grid.Column="{OnIdiom Phone=0, Default=2}"
                        Padding="16,20"
                        BackgroundColor="{StaticResource EduSurfaceAlt}"
                        Stroke="{StaticResource EduBorder}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontFamily="Comfortaa"
                                FontSize="28"
                                HorizontalOptions="Center"
                                Text="{Binding NotesCount}"
                                TextColor="#8B5CF6" />
                            <Label
                                FontFamily="Comfortaa"
                                FontSize="14"
                                HorizontalOptions="Center"
                                Opacity="0.7"
                                Text="Заметки"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  Помодоро (адаптивная позиция)  -->
                    <Border
                        Grid.Row="{OnIdiom Phone=1, Default=0}"
                        Grid.Column="{OnIdiom Phone=1, Default=3}"
                        Padding="16,20"
                        BackgroundColor="{StaticResource EduSurfaceAlt}"
                        Stroke="{StaticResource EduBorder}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontFamily="Comfortaa"
                                FontSize="28"
                                HorizontalOptions="Center"
                                Text="{Binding PomodoroCount}"
                                TextColor="{StaticResource EduWarning}" />
                            <Label
                                FontFamily="Comfortaa"
                                FontSize="14"
                                HorizontalOptions="Center"
                                Opacity="0.7"
                                Text="Помодоро"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!--  ══ НАСТРОЙКИ ══════════════════════════════════════════  -->
                <Border Grid.Row="3" Style="{StaticResource EduCardBorder}">
                    <VerticalStackLayout Spacing="0">

                        <Label
                            Margin="0,0,0,14"
                            FontAttributes="Bold"
                            FontFamily="Comfortaa"
                            FontSize="17"
                            Text="Настройки"
                            TextColor="White" />

                        <!--  Язык  -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Label
                                Grid.Column="0"
                                FontSize="15"
                                Text="Язык приложения"
                                TextColor="White"
                                VerticalOptions="Center" />
                            <Picker
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                FontFamily="Comfortaa"
                                FontSize="13"
                                HorizontalOptions="End"
                                ItemsSource="{Binding Languages}"
                                SelectedItem="{Binding SelectedLanguage}"
                                TextColor="#94A3B8"
                                TitleColor="#64748B"
                                VerticalOptions="Center"
                                WidthRequest="110" />
                        </Grid>

                        <BoxView BackgroundColor="{StaticResource EduBorder}" HeightRequest="1" />

                        <!--  Умные напоминания  -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label
                                    FontSize="15"
                                    Text="Умные напоминания"
                                    TextColor="White" />
                                <Label
                                    FontSize="13"
                                    Text="Напоминания в оптимальное время"
                                    TextColor="{StaticResource EduMutedText}" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding SmartRemindersEnabled}"
                                OnColor="#019301"
                                ThumbColor="White"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView BackgroundColor="{StaticResource EduBorder}" HeightRequest="1" />

                        <!--  Звук и вибрация  -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label
                                    FontSize="15"
                                    Text="Звук и вибрация"
                                    TextColor="White" />
                                <Label
                                    FontSize="13"
                                    Text="Звуки таймера и уведомлений"
                                    TextColor="{StaticResource EduMutedText}" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding SoundVibrationEnabled}"
                                OnColor="#019301"
                                ThumbColor="White"
                                VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!--  ══ ВЫХОД ════════════════════════════════════════════════  -->
                <Border
                    Grid.Row="4"
                    Margin="0,0,0,16"
                    Padding="0,16"
                    BackgroundColor="{StaticResource EduDangerSurface}"
                    Stroke="#7F1D1D"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        FontAttributes="Bold"
                        FontFamily="Comfortaa"
                        FontSize="15"
                        HorizontalOptions="Center"
                        Text="Выйти из аккаунта"
                        TextColor="{StaticResource EduDanger}"
                        VerticalOptions="Center" />
                </Border>

            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
