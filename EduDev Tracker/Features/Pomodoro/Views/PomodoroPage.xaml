<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EduDev_Tracker.Features.Pomodoro.Views.PomodoroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:EduDev_Tracker.Data.Models"
    xmlns:vm="clr-namespace:EduDev_Tracker.Features.Pomodoro.ViewModels"
    Title="Помодоро-таймер"
    x:DataType="vm:PomodoroViewModel"
    BackgroundColor="#0B1120">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#111827" />
                <Setter Property="Stroke" Value="#1E293B" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#F1F5F9" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="MutedLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="#8892A4" />
            </Style>

            <Style x:Key="ControlButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#1E293B" />
                <Setter Property="TextColor" Value="#CBD5E1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="Padding" Value="16,0" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#2DD4BF" />
                <Setter Property="TextColor" Value="#0B1120" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <Grid x:Name="RootGrid">

            <!--  ═══════════ DESKTOP LAYOUT (>= 768px, 3 колонки) ═══════════  -->
            <Grid
                x:Name="DesktopLayout"
                Padding="20,16"
                ColumnDefinitions="300,*,280"
                ColumnSpacing="16"
                IsVisible="False">

                <!--  ─────────── КОЛОНКА 1: ПРЕСЕТЫ ───────────  -->
                <Border Padding="16" Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="0">

                        <Grid Margin="0,0,0,14" ColumnDefinitions="*,Auto">
                            <Label
                                Margin="0"
                                Style="{StaticResource SectionTitle}"
                                Text="Пресеты циклов" />
                            <Border
                                Grid.Column="1"
                                Padding="8,4"
                                BackgroundColor="#1E293B"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0">
                                <Label
                                    FontSize="13"
                                    Text="{Binding SelectedPresetsCountText}"
                                    TextColor="#2DD4BF" />
                            </Border>
                        </Grid>

                        <CollectionView ItemsSource="{Binding Presets}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PomodoroPreset">
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="14,12"
                                        Stroke="{Binding IsDefault, Converter={StaticResource BoolToAccent}}"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="1">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                FontAttributes="Bold"
                                                FontSize="13"
                                                Text="{Binding Name}"
                                                TextColor="#F1F5F9" />

                                            <!--  Кнопка "По умолчанию" (активный пресет)  -->
                                            <Button
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Grid.Column="1"
                                                Padding="8,0"
                                                BackgroundColor="#2DD4BF"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PomodoroViewModel}}, Path=SetDefaultPresetCommand}"
                                                CommandParameter="{Binding .}"
                                                CornerRadius="10"
                                                FontSize="10"
                                                HeightRequest="32"
                                                IsVisible="{Binding IsDefault}"
                                                Text="По умолчанию"
                                                TextColor="#0B1120" />

                                            <!--  Кнопка "Выбрать" (неактивный пресет)  -->
                                            <Button
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Grid.Column="1"
                                                Padding="8,0"
                                                BackgroundColor="#1E3A4A"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PomodoroViewModel}}, Path=SetDefaultPresetCommand}"
                                                CommandParameter="{Binding .}"
                                                CornerRadius="10"
                                                FontSize="10"
                                                HeightRequest="32"
                                                IsVisible="{Binding IsDefault, Converter={StaticResource InverseBool}}"
                                                Text="Выбрать"
                                                TextColor="#2DD4BF" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,4,0,0"
                                                FontSize="13"
                                                TextColor="#64748B">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding WorkMinutes}" TextColor="#94A3B8" />
                                                        <Span Text=" мин работы • " TextColor="#64748B" />
                                                        <Span Text="{Binding ShortBreakMin}" TextColor="#94A3B8" />
                                                        <Span Text=" мин перерыв • " TextColor="#64748B" />
                                                        <Span Text="{Binding CyclesToLong}" TextColor="#94A3B8" />
                                                        <Span Text=" цикла • длинный " TextColor="#64748B" />
                                                        <Span Text="{Binding LongBreakMin}" TextColor="#94A3B8" />
                                                        <Span Text=" мин" TextColor="#64748B" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button
                            Margin="0,8,0,0"
                            BackgroundColor="#1E3A4A"
                            Command="{Binding OpenCreatePresetCommand}"
                            Style="{StaticResource ControlButton}"
                            Text="+ Новый пресет"
                            TextColor="#2DD4BF" />
                    </VerticalStackLayout>
                </Border>

                <!--  ─────────── КОЛОНКА 2: ТАЙМЕР ───────────  -->
                <VerticalStackLayout Grid.Column="1" Spacing="16">

                    <!--  Табы режима  -->
                    <Border Padding="6" Style="{StaticResource SectionCard}">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                            <Button
                                BackgroundColor="{Binding IsWorkPhase, Converter={StaticResource BoolToAccent}}"
                                Command="{Binding SwitchPhaseCommand}"
                                CommandParameter="Work"
                                CornerRadius="14"
                                FontSize="13"
                                HeightRequest="44"
                                Text="Работа"
                                TextColor="{Binding IsWorkPhase, Converter={StaticResource BoolToText}}" />
                            <Button
                                Grid.Column="1"
                                BackgroundColor="{Binding IsShortBreakPhase, Converter={StaticResource BoolToAccent}}"
                                Command="{Binding SwitchPhaseCommand}"
                                CommandParameter="ShortBreak"
                                CornerRadius="14"
                                FontSize="13"
                                HeightRequest="44"
                                Text="Короткий перерыв"
                                TextColor="{Binding IsShortBreakPhase, Converter={StaticResource BoolToText}}" />
                            <Button
                                Grid.Column="2"
                                BackgroundColor="{Binding IsLongBreakPhase, Converter={StaticResource BoolToAccent}}"
                                Command="{Binding SwitchPhaseCommand}"
                                CommandParameter="LongBreak"
                                CornerRadius="14"
                                FontSize="13"
                                HeightRequest="44"
                                Text="Длинный перерыв"
                                TextColor="{Binding IsLongBreakPhase, Converter={StaticResource BoolToText}}" />
                        </Grid>
                    </Border>

                    <!--  Круговой таймер  -->
                    <Border Padding="24,32" Style="{StaticResource SectionCard}">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="0">

                            <!--  Кольцо  -->
                            <Grid
                                HeightRequest="240"
                                HorizontalOptions="Center"
                                WidthRequest="240">
                                <Ellipse
                                    Fill="Transparent"
                                    HeightRequest="240"
                                    Stroke="#1E293B"
                                    StrokeThickness="12"
                                    WidthRequest="240" />
                                <GraphicsView
                                    x:Name="TimerRingDesktop"
                                    Drawable="{Binding TimerRing}"
                                    HeightRequest="240"
                                    WidthRequest="240" />
                                <VerticalStackLayout
                                    HorizontalOptions="Center"
                                    Spacing="4"
                                    VerticalOptions="Center">
                                    <Label
                                        CharacterSpacing="1"
                                        FontSize="13"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding PhaseLabel}"
                                        TextColor="#64748B" />
                                    <Label
                                        CharacterSpacing="-1"
                                        FontAttributes="Bold"
                                        FontSize="52"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding TimeDisplay}"
                                        TextColor="#F1F5F9" />
                                    <Label
                                        FontSize="13"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding CycleDisplay}"
                                        TextColor="#64748B" />
                                </VerticalStackLayout>
                            </Grid>

                            <!--  Привязанная задача  -->
                            <Label
                                Margin="0,20,0,0"
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                TextColor="#8892A4">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding LinkedTaskProject}" TextColor="#8892A4" />
                                        <Span Text=" • " TextColor="#64748B" />
                                        <Span Text="{Binding LinkedTaskTitle}" TextColor="#94A3B8" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Кнопки управления  -->
                            <Grid
                                Margin="0,28,0,0"
                                ColumnDefinitions="Auto,*,Auto,Auto"
                                ColumnSpacing="10">
                                <Button
                                    Grid.Column="0"
                                    Command="{Binding ToggleTimerCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Text="{Binding StartPauseLabel}"
                                    WidthRequest="140" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding SkipPhaseCommand}"
                                    Style="{StaticResource ControlButton}"
                                    Text="Пропустить" />
                                <Button
                                    Grid.Column="3"
                                    Padding="14,0"
                                    BackgroundColor="#1E293B"
                                    Command="{Binding FinishSessionCommand}"
                                    CornerRadius="14"
                                    FontSize="13"
                                    HeightRequest="44"
                                    Text="Завершить"
                                    TextColor="#EF4444" />
                            </Grid>

                            <!--  Фоновый режим + привязка задачи  -->
                            <Grid
                                Margin="0,18,0,0"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12">
                                <Border
                                    Padding="12,6"
                                    BackgroundColor="#1E3A4A"
                                    StrokeShape="RoundRectangle 20"
                                    StrokeThickness="0">
                                    <Label FontSize="13" TextColor="#2DD4BF">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="● " TextColor="#2DD4BF" />
                                                <Span Text="Фоновый режим активен" TextColor="#2DD4BF" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Border>
                                <Button
                                    Grid.Column="1"
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    Command="{Binding PickTaskCommand}"
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    Text="Привязать к другой задаче"
                                    TextColor="#2DD4BF" />
                            </Grid>

                            <!--  Быстрая статистика сессии  -->
                            <Grid
                                Margin="0,20,0,0"
                                ColumnDefinitions="*,*,*"
                                ColumnSpacing="10">
                                <Border
                                    Padding="12,10"
                                    BackgroundColor="#0F172A"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding TodayPomodoros}"
                                            TextColor="#F1F5F9" />
                                        <Label
                                            HorizontalTextAlignment="Center"
                                            Style="{StaticResource MutedLabel}"
                                            Text="Сегодня" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Padding="12,10"
                                    BackgroundColor="#0F172A"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding WeekSessions}"
                                            TextColor="#F1F5F9" />
                                        <Label
                                            HorizontalTextAlignment="Center"
                                            Style="{StaticResource MutedLabel}"
                                            Text="На этой неделе" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border
                                    Grid.Column="2"
                                    Padding="12,10"
                                    BackgroundColor="#0F172A"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding WeekFocusTime}"
                                            TextColor="#F1F5F9" />
                                        <Label
                                            HorizontalTextAlignment="Center"
                                            Style="{StaticResource MutedLabel}"
                                            Text="Чистое время" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!--  ─────────── КОЛОНКА 3: ПРАВАЯ ПАНЕЛЬ ───────────  -->
                <VerticalStackLayout Grid.Column="2" Spacing="12">

                    <!--  Текущая задача  -->
                    <Border Padding="20" Style="{StaticResource SectionCard}">
                        <VerticalStackLayout Spacing="12">
                            <Label
                                FontSize="17"
                                Style="{StaticResource SectionTitle}"
                                Text="Текущая задача" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label
                                    FontSize="14"
                                    Style="{StaticResource MutedLabel}"
                                    Text="Проект"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    HorizontalTextAlignment="End"
                                    Text="{Binding LinkedTaskProject}"
                                    TextColor="#94A3B8" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label
                                    FontSize="14"
                                    Style="{StaticResource MutedLabel}"
                                    Text="Задача"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    HorizontalTextAlignment="End"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding LinkedTaskTitle}"
                                    TextColor="#94A3B8" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label
                                    FontSize="14"
                                    Style="{StaticResource MutedLabel}"
                                    Text="Осталось помодоро"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    HorizontalTextAlignment="End"
                                    Text="{Binding RemainingPomodorosText}"
                                    TextColor="#2DD4BF" />
                            </Grid>
                            <Button
                                Margin="0,4,0,0"
                                Command="{Binding PickTaskCommand}"
                                Style="{StaticResource ControlButton}"
                                Text="Выбрать другую задачу" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  Статистика по дням  -->
                    <Border Padding="20" Style="{StaticResource SectionCard}">
                        <VerticalStackLayout Spacing="12">
                            <Label Style="{StaticResource SectionTitle}" Text="Статистика по дням" />
                            <Label
                                FontSize="13"
                                Text="{Binding WeekStatsDescription}"
                                TextColor="#64748B" />
                            <CollectionView HeightRequest="120" ItemsSource="{Binding WeekDayStats}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="6" Orientation="Horizontal" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DayStatItem">
                                        <VerticalStackLayout
                                            HorizontalOptions="Center"
                                            Spacing="4"
                                            WidthRequest="34">
                                            <BoxView
                                                CornerRadius="5"
                                                HeightRequest="{Binding BarHeight}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="End"
                                                WidthRequest="22"
                                                Color="{Binding BarColor}" />
                                            <Label
                                                FontSize="13"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding DayLetter}"
                                                TextColor="#64748B" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Итоги за месяц  -->
                    <Border Padding="20" Style="{StaticResource SectionCard}">
                        <VerticalStackLayout Spacing="12">
                            <Label Style="{StaticResource SectionTitle}" Text="Итоги за месяц" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontSize="15"
                                    Text="Всего помодоро"
                                    TextColor="#94A3B8" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="17"
                                    Text="{Binding MonthTotal}"
                                    TextColor="#F1F5F9" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontSize="15"
                                    Text="Среднее в день"
                                    TextColor="#94A3B8" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="17"
                                    Text="{Binding MonthAvgPerDay}"
                                    TextColor="#F1F5F9" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontSize="15"
                                    Text="Самый продуктивный день"
                                    TextColor="#94A3B8" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="17"
                                    Text="{Binding MonthBestDay}"
                                    TextColor="#2DD4BF" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Grid>
            <!--  END DesktopLayout  -->

            <!--  ═══════════ MOBILE LAYOUT (< 768px, 1 колонка) ═══════════  -->
            <VerticalStackLayout
                x:Name="MobileLayout"
                Padding="14,12"
                IsVisible="False"
                Spacing="12">
                <Image
                    HeightRequest="36"
                    HorizontalOptions="Start"
                    IsVisible="{OnIdiom Phone=True,
                                        Default=False}"
                    Source="menu.png"
                    VerticalOptions="Center"
                    WidthRequest="36">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped" />
                    </Image.GestureRecognizers>
                </Image>

                <!--  Табы режима  -->
                <Border Padding="6" Style="{StaticResource SectionCard}">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                        <Button
                            BackgroundColor="{Binding IsWorkPhase, Converter={StaticResource BoolToAccent}}"
                            Command="{Binding SwitchPhaseCommand}"
                            CommandParameter="Work"
                            CornerRadius="12"
                            FontSize="12"
                            HeightRequest="38"
                            Text="Работа"
                            TextColor="{Binding IsWorkPhase, Converter={StaticResource BoolToText}}" />
                        <Button
                            Grid.Column="1"
                            BackgroundColor="{Binding IsShortBreakPhase, Converter={StaticResource BoolToAccent}}"
                            Command="{Binding SwitchPhaseCommand}"
                            CommandParameter="ShortBreak"
                            CornerRadius="12"
                            FontSize="12"
                            HeightRequest="38"
                            Text="Кор. перерыв"
                            TextColor="{Binding IsShortBreakPhase, Converter={StaticResource BoolToText}}" />
                        <Button
                            Grid.Column="2"
                            BackgroundColor="{Binding IsLongBreakPhase, Converter={StaticResource BoolToAccent}}"
                            Command="{Binding SwitchPhaseCommand}"
                            CommandParameter="LongBreak"
                            CornerRadius="12"
                            FontSize="12"
                            HeightRequest="38"
                            Text="Дл. перерыв"
                            TextColor="{Binding IsLongBreakPhase, Converter={StaticResource BoolToText}}" />
                    </Grid>
                </Border>

                <!--  Таймер mobile  -->
                <Border Padding="24,32" Style="{StaticResource SectionCard}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="0">
                        <Grid
                            HeightRequest="210"
                            HorizontalOptions="Center"
                            WidthRequest="210">
                            <Ellipse
                                Fill="Transparent"
                                HeightRequest="210"
                                Stroke="#1E293B"
                                StrokeThickness="10"
                                WidthRequest="210" />
                            <GraphicsView
                                x:Name="TimerRingMobile"
                                Drawable="{Binding TimerRing}"
                                HeightRequest="210"
                                WidthRequest="210" />
                            <VerticalStackLayout
                                HorizontalOptions="Center"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontSize="13"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding PhaseLabel}"
                                    TextColor="#64748B" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="44"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding TimeDisplay}"
                                    TextColor="#F1F5F9" />
                                <Label
                                    FontSize="13"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding CycleDisplay}"
                                    TextColor="#64748B" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label
                            Margin="0,14,0,0"
                            FontSize="13"
                            HorizontalTextAlignment="Center"
                            Text="{Binding LinkedTaskTitle}"
                            TextColor="#8892A4" />
                        <Grid
                            Margin="0,20,0,0"
                            ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="8">
                            <Button
                                Command="{Binding ToggleTimerCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Text="{Binding StartPauseLabel}" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding SkipPhaseCommand}"
                                FontSize="18"
                                Style="{StaticResource ControlButton}"
                                Text="⏭"
                                WidthRequest="48" />
                            <Button
                                Grid.Column="2"
                                BackgroundColor="#1E293B"
                                Command="{Binding FinishSessionCommand}"
                                CornerRadius="14"
                                FontSize="18"
                                HeightRequest="44"
                                Text="⏹"
                                TextColor="#EF4444"
                                WidthRequest="48" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--  Быстрая статистика mobile  -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border
                        Padding="10,10"
                        BackgroundColor="#111827"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="0">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                HorizontalTextAlignment="Center"
                                Text="{Binding TodayPomodoros}"
                                TextColor="#F1F5F9" />
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource MutedLabel}"
                                Text="Сегодня" />
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Padding="10,10"
                        BackgroundColor="#111827"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="0">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                HorizontalTextAlignment="Center"
                                Text="{Binding WeekSessions}"
                                TextColor="#F1F5F9" />
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource MutedLabel}"
                                Text="Неделя" />
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Padding="10,10"
                        BackgroundColor="#111827"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="0">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalTextAlignment="Center"
                                Text="{Binding WeekFocusTime}"
                                TextColor="#F1F5F9" />
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource MutedLabel}"
                                Text="Фокус" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!--  Текущая задача mobile  -->
                <Border Padding="20" Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            FontSize="17"
                            Style="{StaticResource SectionTitle}"
                            Text="Текущая задача" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                FontSize="15"
                                LineBreakMode="TailTruncation"
                                Text="{Binding LinkedTaskTitle}"
                                TextColor="#CBD5E1"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding RemainingPomodorosText}"
                                TextColor="#2DD4BF"
                                VerticalOptions="Center" />
                        </Grid>
                        <Button
                            Command="{Binding PickTaskCommand}"
                            Style="{StaticResource ControlButton}"
                            Text="Выбрать задачу" />
                    </VerticalStackLayout>
                </Border>

                <!--  Пресеты mobile (горизонтальный скролл)  -->
                <Label
                    Margin="4,4,0,0"
                    Style="{StaticResource SectionTitle}"
                    Text="Пресеты" />
                <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Presets}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PomodoroPreset">
                                <Border
                                    Padding="14,12"
                                    Stroke="{Binding IsDefault, Converter={StaticResource BoolToAccent}}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="1"
                                    WidthRequest="200">
                                    <VerticalStackLayout Spacing="6">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Text="{Binding Name}"
                                            TextColor="#F1F5F9" />
                                        <Label FontSize="13" TextColor="#64748B">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding WorkMinutes}" />
                                                    <Span Text=" / " />
                                                    <Span Text="{Binding ShortBreakMin}" />
                                                    <Span Text=" мин • " />
                                                    <Span Text="{Binding CyclesToLong}" />
                                                    <Span Text=" цикла" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Button
                                            Padding="0"
                                            BackgroundColor="#1E3A4A"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PomodoroViewModel}}, Path=SetDefaultPresetCommand}"
                                            CommandParameter="{Binding .}"
                                            CornerRadius="10"
                                            FontSize="10"
                                            HeightRequest="30"
                                            Text="Выбрать"
                                            TextColor="#2DD4BF" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
                <Button
                    Margin="0,8,0,0"
                    BackgroundColor="#1E3A4A"
                    Command="{Binding OpenCreatePresetCommand}"
                    Style="{StaticResource ControlButton}"
                    Text="+ Новый пресет"
                    TextColor="#2DD4BF" />

                <!--  Итоги за месяц mobile  -->
                <Border
                    Margin="0,0,0,20"
                    Padding="20"
                    Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource SectionTitle}" Text="Итоги за месяц" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                FontSize="15"
                                Text="Всего помодоро"
                                TextColor="#94A3B8" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="17"
                                Text="{Binding MonthTotal}"
                                TextColor="#F1F5F9" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                FontSize="15"
                                Text="Среднее в день"
                                TextColor="#94A3B8" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="17"
                                Text="{Binding MonthAvgPerDay}"
                                TextColor="#F1F5F9" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                FontSize="15"
                                Text="Лучший день"
                                TextColor="#94A3B8" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="17"
                                Text="{Binding MonthBestDay}"
                                TextColor="#2DD4BF" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
            <!--  END MobileLayout  -->

        </Grid>
    </ScrollView>
</ContentPage>
