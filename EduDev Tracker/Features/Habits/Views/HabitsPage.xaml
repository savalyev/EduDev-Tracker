<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EduDev_Tracker.Features.Habits.Views.HabitsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:EduDev_Tracker.Features.Habits.ViewModels"
    Title=""
    x:DataType="vm:HabitsViewModel"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False">

    <ContentPage.Behaviors>
        <mct:EventToCommandBehavior Command="{Binding LoadCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ScrollView>

        <Grid>

            <Image
                Aspect="Fill"
                Opacity="0.8"
                Source="background_gradient.jpg" />

            <Grid
                MaximumWidthRequest="1500"
                RowDefinitions="Auto, *"
                RowSpacing="40">

                <Grid
                    Grid.Row="0"
                    Padding="40"
                    ColumnDefinitions="Auto, *, Auto"
                    VerticalOptions="Center">

                    <Image
                        HeightRequest="45"
                        HorizontalOptions="Start"
                        Source="menu.png"
                        VerticalOptions="Start"
                        WidthRequest="45">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuTapped" />
                        </Image.GestureRecognizers>
                    </Image>

                    <VerticalStackLayout
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        VerticalOptions="Start">

                        <Label Style="{StaticResource EduCardTitleLabel}" Text="Привычки" />
                        <Label Style="{StaticResource EduCardSubtitleLabel}" Text="Отслеживайте ежедневные действия, серии и прогресс по целям" />

                    </VerticalStackLayout>

                    <Border
                        Grid.Column="2"
                        HorizontalOptions="End"
                        Style="{StaticResource EduPrimaryButtonBorder}"
                        VerticalOptions="Start"
                        WidthRequest="205">
                        <HorizontalStackLayout HorizontalOptions="Center">

                            <Button Style="{StaticResource EduPrimaryButton}" Text="Перейти в архив" />

                        </HorizontalStackLayout>
                    </Border>

                </Grid>

                <Grid
                    Grid.Row="1"
                    Padding="40,0,40,0"
                    ColumnDefinitions="Auto, Auto"
                    ColumnSpacing="20"
                    HorizontalOptions="Start"
                    VerticalOptions="Start">

                    <Border
                        Grid.Column="0"
                        MaximumHeightRequest="500"
                        Style="{StaticResource EduCardBorder}">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, *, Auto">

                            <Label Style="{StaticResource EduCardTitleLabel}" Text="Список привычек" />
                            <Label
                                Grid.Row="1"
                                Style="{StaticResource EduCardSubtitleLabel}"
                                Text="Сегодня активных: 0, выполнено: 0" />
                            <Border
                                Grid.Column="1"
                                BackgroundColor="#14182E"
                                Stroke="White"
                                StrokeShape="RoundRectangle 15"
                                StrokeThickness="0.5">
                                <HorizontalStackLayout Padding="10,8,10,8" Spacing="10">
                                    <Button Style="{StaticResource EduButtonHorizontalSelect}" Text="Сегодня" />
                                    <Button Style="{StaticResource EduButtonHorizontalSelect}" Text="Неделя" />
                                    <Button Style="{StaticResource EduButtonHorizontalSelect}" Text="Все" />
                                </HorizontalStackLayout>
                            </Border>
                            <HorizontalStackLayout
                                Grid.Row="2"
                                Margin="0,10,0,0"
                                Spacing="5">
                                <Button Style="{StaticResource EduDarkButtonSelection}" Text="Все типы" />
                                <Button Style="{StaticResource EduDarkButtonSelection}" Text="Бинарные" />
                                <Button Style="{StaticResource EduDarkButtonSelection}" Text="Количественные" />
                                <Button Style="{StaticResource EduDarkButtonSelection}" Text="По времени" />
                            </HorizontalStackLayout>
                            <CollectionView
                                Grid.Row="3"
                                Margin="0,20,0,0"
                                ItemsSource="{Binding Habits}"
                                SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="5" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HabitItemViewModel">
                                        <Border
                                            Background="#10172A"
                                            Stroke="#495061"
                                            StrokeThickness="1">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>

                                            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto" RowDefinitions="Auto">

                                                <Border
                                                    Grid.Column="0"
                                                    Margin="20,0,0,0"
                                                    Padding="10"
                                                    Background="#1D3A3A"
                                                    HeightRequest="52"
                                                    Stroke="#996EE7B7"
                                                    VerticalOptions="Center"
                                                    WidthRequest="52">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="14" />
                                                    </Border.StrokeShape>
                                                    <Image Aspect="Fill" Source="{Binding Icon}" />
                                                </Border>

                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Margin="10,10,0,10"
                                                    VerticalOptions="Start">
                                                    <Label
                                                        FontFamily="Comfortaa"
                                                        FontSize="20"
                                                        Text="{Binding TitleHabit}"
                                                        TextColor="White" />
                                                    <Label
                                                        FontFamily="Comfortaa"
                                                        FontSize="10"
                                                        Text="{Binding Description}"
                                                        TextColor="#99FFFFFF" />

                                                    <HorizontalStackLayout Margin="0,5,0,0" Spacing="5">
                                                        <Border
                                                            Padding="8,3"
                                                            Background="#182333"
                                                            Stroke="#4A5A6A"
                                                            StrokeThickness="1">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="12" />
                                                            </Border.StrokeShape>
                                                            <Label
                                                                FontFamily="Comfortaa"
                                                                FontSize="13"
                                                                Text="{Binding Schedule}"
                                                                TextColor="#99FFFFFF" />
                                                        </Border>
                                                        <Border
                                                            Padding="8,3"
                                                            Background="#182333"
                                                            Stroke="#4A5A6A"
                                                            StrokeThickness="1">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="12" />
                                                            </Border.StrokeShape>
                                                            <Label
                                                                FontFamily="Comfortaa"
                                                                FontSize="13"
                                                                Text="{Binding TimeOfDay}"
                                                                TextColor="#99FFFFFF" />
                                                        </Border>
                                                        <Border
                                                            Padding="8,3"
                                                            Background="#182333"
                                                            Stroke="#4A5A6A"
                                                            StrokeThickness="1">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="12" />
                                                            </Border.StrokeShape>
                                                            <Label
                                                                FontFamily="Comfortaa"
                                                                FontSize="13"
                                                                Text="{Binding Type}"
                                                                TextColor="#99FFFFFF" />
                                                        </Border>
                                                    </HorizontalStackLayout>

                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Column="2" Margin="0,10,0,0">
                                                    <Label
                                                        FontFamily="Comfortaa"
                                                        FontSize="15"
                                                        Text="{Binding TodayProgressText}"
                                                        TextColor="#99FFFFFF" />
                                                </VerticalStackLayout>

                                                <VerticalStackLayout
                                                    Grid.Column="3"
                                                    Margin="0,10,0,0"
                                                    Spacing="5">
                                                    <Label
                                                        FontFamily="Comfortaa"
                                                        FontSize="15"
                                                        Text="Серия"
                                                        TextColor="#99FFFFFF" />
                                                    <Label
                                                        FontFamily="Comfortaa"
                                                        FontSize="15"
                                                        Text="{Binding StreakText}"
                                                        TextColor="#99FFFFFF" />
                                                    <Label
                                                        FontFamily="Comfortaa"
                                                        FontSize="15"
                                                        Text="Календарь выполнения"
                                                        TextColor="#99FFFFFF" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout
                                                    Grid.Column="4"
                                                    Margin="0,10,0,0"
                                                    Spacing="5"
                                                    VerticalOptions="Center">
                                                    <Switch
                                                        IsToggled="{Binding IsCompleted, Mode=TwoWay}"
                                                        OffColor="Gray"
                                                        OnColor="Green"
                                                        ThumbColor="White" />
                                                </VerticalStackLayout>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <Button
                                Grid.Row="4"
                                Margin="0,20,0,0"
                                Command="{Binding OpenAddHabitCommand}"
                                HeightRequest="39"
                                Style="{StaticResource EduPrimaryButton}"
                                Text="+ Добавьте ещё привычку, чтобы усилить прогресс недели" />

                        </Grid>
                    </Border>

                    <VerticalStackLayout Grid.Column="1">
                        <Border Style="{StaticResource EduCardBorder}">
                            <VerticalStackLayout>
                                <Label Style="{StaticResource EduCardTitleLabel}" Text="Календарь выполнения" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>



                </Grid>



            </Grid>

        </Grid>
    </ScrollView>


</ContentPage>